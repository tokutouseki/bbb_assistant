# 模型路径环境变量配置
# 复制为.env文件并修改

# ModelScope缓存目录
MODELSCOPE_CACHE="D:\TokusCode\models"

# VoxCPM模型路径
VOXCPM_MODEL_PATH="D:\TokusCode\models\VoxCPM-0.5B"

# SenseVoice模型路径
ASR_MODEL_PATH="D:\TokusCode\models\SenseVoiceSmall"

# 跳过运行时下载
SKIP_MODEL_DOWNLOAD=true

# GPU设备设置
CUDA_VISIBLE_DEVICES=0

# 本地LLM运行方式: local / lmstudio / auto
LLM_RUNTIME=auto

# 本地GGUF主模型路径（无需LM Studio）
LLM_LOCAL_MODEL_PATH="D:\LLM\unsloth\Qwen3.5-4B-GGUF\Qwen3.5-4B-Q4_K_S.gguf"

# 多模态投影模型路径（可选，用于视觉能力）
LLM_LOCAL_MMPROJ_PATH="D:\LLM\unsloth\Qwen3.5-4B-GGUF\mmproj-F32.gguf"

# 本地推理参数
LLM_LOCAL_CONTEXT_LENGTH=4096
LLM_LOCAL_GPU_LAYERS=0
LLM_LOCAL_THREADS=8

# 外部模型目录（ASR/TTS/OCR）
MODEL_ASSETS_ROOT="D:\TokusCode\models"
ASR_MODEL_PATH="D:\TokusCode\models\SenseVoiceSmall"
VOXCPM_MODEL_PATH="D:\TokusCode\models\VoxCPM-0.5B"
QWEN3_TTS_MODEL_PATH="D:\TokusCode\models\Qwen3-TTS"
OCR_MODELS_DIR="D:\TokusCode\models\OCR"
ZIPENHANCER_MODEL_PATH="D:\TokusCode\models\zipenhancer\models\iic\speech_zipenhancer_ans_multiloss_16k_base"

# LM Studio作为可选兜底
LM_STUDIO_BASE_URL="http://127.0.0.1:1234"
LM_STUDIO_MODEL="qwen3.5-4b"
OLLAMA_BASE_URL="http://127.0.0.1:11434"
OLLAMA_MODEL="qwen2.5:7b"
