# 崩坏3专属AI陪伴助手 - 环境变量配置
# 复制此文件为 .env 并根据需要修改配置

# ==================== 应用基础配置 ====================
APP_NAME="崩坏3专属AI陪伴助手"
APP_VERSION="0.1.0"
ENVIRONMENT="development"  # development, testing, production
DEBUG=true

# ==================== 服务器配置 ====================
HOST="0.0.0.0"
PORT=8000
WORKERS=1
ENABLE_RELOAD=true
ENABLE_ACCESS_LOG=true

# ==================== API配置 ====================
API_PREFIX="/api"
ENABLE_DOCS=true
ENABLE_OPENAPI=true

# ==================== 跨域配置 ====================
CORS_ORIGINS="http://localhost:5173,http://localhost:3000,http://localhost:8080"

# ==================== 数据库配置 ====================
DATABASE_URL="sqlite:///./data/bbb_assistant.db"
DATABASE_ECHO=false

# ==================== Redis配置（可选） ====================
# REDIS_URL="redis://localhost:6379"
# REDIS_PASSWORD=""

# ==================== 日志配置 ====================
LOG_LEVEL="INFO"
LOG_FILE="./logs/app.log"
LOG_ROTATION="10 MB"
LOG_RETENTION="30 days"

# ==================== 安全配置 ====================
SECRET_KEY="your-secret-key-change-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ==================== AI模型配置 ====================
LOAD_MODELS_ON_STARTUP=false

# ==================== YOLO11n配置 ====================
YOLO_MODEL_PATH="./data/models/yolo/yolo11n.pt"
YOLO_CONF_THRESHOLD=0.5
YOLO_IOU_THRESHOLD=0.45

# ==================== OCR配置 ====================
OCR_LANGUAGE="ch"
OCR_USE_GPU=true

# ==================== 语音识别配置 ====================
ASR_MODEL="base"  # tiny, base, small, medium, large
ASR_LANGUAGE="zh"

# ==================== 语音合成配置 ====================
TTS_MODEL="tts_models/zh-CN/baker/tacotron2-DDC"
TTS_SPEAKER_WAV=""

# ==================== 大模型配置 ====================
LLM_PROVIDER="deepseek"  # deepseek, kimi, openai

# DeepSeek配置
DEEPSEEK_API_KEY="your-deepseek-api-key-here"
DEEPSEEK_BASE_URL="https://api.deepseek.com"

# Kimi配置
# KIMI_API_KEY="your-kimi-api-key-here"

# OpenAI配置
# OPENAI_API_KEY="your-openai-api-key-here"
# OPENAI_BASE_URL="https://api.openai.com/v1"

LLM_MODEL="deepseek-chat"
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2000

# ==================== RAG配置 ====================
RAG_ENABLED=true
KNOWLEDGE_BASE_PATH="./data/knowledge_base"
VECTOR_STORE_PATH="./data/vectors"
EMBEDDING_MODEL="paraphrase-multilingual-MiniLM-L12-v2"

# ==================== 游戏监控配置 ====================
ENABLE_GAME_MONITOR=true
GAME_MONITOR_INTERVAL=1.0
GAME_WINDOW_TITLE="崩坏3"

# ==================== 聊天服务配置 ====================
ENABLE_CHAT_SERVICE=true
CHAT_HISTORY_LIMIT=50

# ==================== 记忆配置 ====================
MEMORY_ENABLED=true
MEMORY_STORE_PATH="./data/memory"
MEMORY_RETENTION_DAYS=30

# ==================== 文件存储配置 ====================
UPLOAD_DIR="./data/uploads"
MAX_UPLOAD_SIZE=104857600  # 100MB

# ==================== 静态文件配置 ====================
ENABLE_STATIC_FILES=true
STATIC_DIR="./static"

# ==================== WebSocket配置 ====================
WEBSOCKET_ENABLED=true
WEBSOCKET_PING_INTERVAL=30.0

# ==================== 性能配置 ====================
REQUEST_TIMEOUT=30
MAX_CONCURRENT_REQUESTS=100

# ==================== Uvicorn日志级别 ====================
UVICORN_LOG_LEVEL="info"

# ==================== 搜索配置 ====================
DEFAULT_SEARCH_ENGINE="google"  # google, duckduckgo, miyoushe, honkai_official
MIYOUSHE_SEARCH_URL="https://www.miyoushe.com/bh3/search?keyword="
HONKAI_OFFICIAL_URL="https://bh3.mihoyo.com/main"

# ==================== 前端环境变量 ====================
VITE_APP_TITLE="崩坏3专属AI陪伴助手"
VITE_API_BASE_URL="http://localhost:8000"
VITE_WS_BASE_URL="ws://localhost:8000/ws"
VITE_ELECTRON_ENV="development"
VITE_APP_VERSION="0.1.0"

# ==================== 开发工具配置 ====================
# 启用开发工具
DEV_TOOLS_ENABLED=true

# 启用调试日志
DEBUG_LOGGING=true

# 模拟数据（开发时使用）
USE_MOCK_DATA=false

# ==================== 注意事项 ====================
# 1. 生产环境务必修改 SECRET_KEY
# 2. 根据实际情况配置 API 密钥
# 3. 数据库文件将保存在 data/ 目录下
# 4. 模型文件需要额外下载，首次运行时会提示下载