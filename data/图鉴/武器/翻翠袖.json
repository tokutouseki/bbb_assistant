6%B8%B8%E8%A3%85%E5%A4%87%E6%97%B6%E4%B8%BA%E6%95%8C%E4%BA%BA%E6%96%BD%E5%8A%A0%E6%9D%A5%E8%87%AA%E8%87%AA%E8%BA%AB%E7%9A%84%E7%89%A9%E7%90%86%E6%98%93%E4%BC%A4%EF%BC%88%E7%8B%AC%E7%AB%8B%E5%8A%A0%E6%88%90%E3%80%81%E5%94%AF%E4%B8%80%E7%94%9F%E6%95%88%EF%BC%89%E3%80%82%3C%2Fp%3E%3Cp%20style%3D%5C%22white-space%3A%20pre-wrap%3B%20min-height%3A%201.5em%3B%5C%22%3E%3C%2Fp%3E%3Cp%20style%3D%5C%22white-space%3A%20pre-wrap%3B%5C%22%3E%E3%80%90%E9%80%9A%E7%94%A8%E6%80%A7%E8%83%BD%E3%80%91%E5%B8%B8%E9%A9%BB%E6%8F%90%E5%8D%87%E8%A7%92%E8%89%B2%E6%B5%81%E8%A1%80%E4%BC%A4%E5%AE%B3%EF%BC%9B%E4%BD%A9%E6%88%B4%E8%A7%92%E8%89%B2%E6%8B%A5%E6%9C%89%E5%A4%A9%E6%B8%8A%E6%98%93%E4%BD%8D%E7%89%B9%E6%80%A7%E6%97%B6%E6%8F%90%E9%AB%98%E7%89%A9%E4%BC%A4%E3%80%82%3C%2Fp%3E%3Cp%20style%3D%5C%22white-space%3A%20pre-wrap%3B%5C%22%3E%E3%80%90%E8%A7%92%E8%89%B2%E7%9B%B8%E6%80%A7%E3%80%91%E4%B8%80%E5%AE%A2%E9%80%8D%E6%B8%B8%E8%A3%85%E5%A4%87%E6%97%B6%EF%BC%8C%E8%83%BD%E5%A4%9F%E6%96%BD%E5%8A%A0%E9%A2%9D%E5%A4%96%E6%B5%81%E8%A1%80%E7%A7%AF%E8%93%84%E5%80%BC%EF%BC%8C%E5%87%BB%E6%9D%80%E6%95%8C%E4%BA%BA%E5%8F%AF%E5%88%B7%E6%96%B0%E6%AD%A6%E5%99%A8%E6%8A%80%E5%86%B7%E5%8D%B4%E6%97%B6%E9%97%B4%E3%80%82%E6%98%9F%E4%B9%8B%E7%8E%AF%E6%BF%80%E6%B4%BB%E6%97%B6%EF%BC%8C%E6%8F%90%E9%AB%98%E8%87%AA%E8%BA%AB%E7%89%A9%E4%BC%A4%E5%92%8C%E5%85%A8%E9%98%9F%E5%85%A8%E4%BC%A4%EF%BC%8C%E6%96%97%E8%BD%AC%E6%98%9F%E7%A7%BB%E6%9C%9F%E9%97%B4%E9%80%A0%E6%88%90%E7%9A%84%E4%BC%A4%E5%AE%B3%E8%BF%9B%E4%B8%80%E6%AD%A5%E6%8F%90%E9%AB%98%E3%80%82%3C%2Fp%3E%22%7D%7D%5D\" data-ts=\"1743011211999\" data-col-type=\"l2r1\"><div style=\"order: 0;\"> <div data-part=\"role\" data-tmpl=\"weapon\" class=\"obc-tmpl__part obc-tmpl-weapon obc-tmpl__part--role obc-tmpl__part--align-banner\"><h2>适用角色</h2> <table class=\"obc-tmpl__gain-method obc-tmpl-weapon__role-table\"><colgroup><col> <col></colgroup> <tbody><tr><td class=\"h3\"><div class=\"role-icon-td\"><div><img src=\"https://act-upload.mihoyo.com/bh3-wiki/2025/03/24/50494840/bb75a6520c743ba9aacb77101fb724bf_2882750872905800734.png\" alt=\"\"></div> <span>一客逍游</span></div></td> <td><div class=\"obc-tmpl-weapon__role-stars\"><span>推荐指数</span> <div><i class=\"obc-tmpl__rate-icon\"></i><i class=\"obc-tmpl__rate-icon\"></i><i class=\"obc-tmpl__rate-icon\"></i><i class=\"obc-tmpl__rate-icon\"></i><i class=\"obc-tmpl__rate-icon\"></i></div></div></td> <td colspan=\"3\" class=\"obc-tmpl__rich-text\"><p style=\"white-space: pre-wrap;\">推荐武器。提高输出和辅助能力，普攻和武器技能施加额外流血积蓄值，且击杀后可刷新武器技。</p></td></tr></tbody></table> <!----></div></div><div style=\"order: 1;\"> <div data-part=\"review\" data-tmpl=\"weapon\" class=\"obc-tmpl__part obc-tmpl-weapon obc-tmpl__part--review obc-tmpl__part--align-banner\"><h2>武器测评</h2> <div class=\"obc-tmpl-valkyrie__skill-container\"><div><img src=\"\" class=\"mobile-gif\"></div> <div class=\"obc-tmpl-valkyrie__skill-item\"><div class=\"obc-tmpl-valkyrie__skill-item-desc\"><div class=\"text\"><p style=\"white-space: pre-wrap;\">【同调技能】提高敌人受到来自场上角色造成的全伤（独立加成、唯一生效）。一客逍游装备时为敌人施加来自自身的物理易伤（独立加成、唯一生效）。</p><p style=\"white-space: pre-wrap; min-height: 1.5em;\"></p><p style=\"white-space: pre-wrap;\">【通用性能】常驻提升角色流血伤害；佩戴角色拥有天渊易位特性时提高物伤。</p><p style=\"white-space: pre-wrap;\">【角色相性】一客逍游装备时，能够施加额外流血积蓄值，击杀敌人可刷新武器技冷却时间。星之环激活时，提高自身物伤和全队全伤，斗转星移期间造成的伤害进一步提高。</p></div> <!----></div></div></div> <!----></div></div></div><p style=\"white-space: pre-wrap; min-height: 1.5em;\"></p></div></div> <div data-v-f0365338=\"\" class=\"detail__body-endpart\"><hr data-v-f0365338=\"\"> <p data-v-f0365338=\"\" class=\"detail__copyright\"><img data-v-f0365338=\"\" src=\"data:image/png;base64,\">\n        词条内容由圣芙蕾雅档案馆编辑团队原创，禁止转载\n      </p></div> <!---->",
