ap%3B%5C%22%3E%E7%BD%AE%E6%8D%A2%E7%A9%BA%E9%97%B4%E5%85%91%E6%8D%A2%EF%BC%88%E6%A6%82%E7%8E%87%E5%88%B7%E5%87%BA%EF%BC%89%3C%2Fp%3E%22%7D%2C%7B%22key%22%3A%22%E5%A4%A7%E4%BC%9F%E5%93%A5%E5%88%AB%E5%A2%85%22%2C%22value%22%3A%22%3Cp%20style%3D%5C%22white-space%3A%20pre-wrap%3B%5C%22%3E%E6%B6%88%E8%80%97%E5%A4%A7%E4%BC%9F%E5%93%A5%E9%BB%91%E9%87%91%E5%8D%A1%E8%8E%B7%E5%8F%96%3C%2Fp%3E%22%7D%2C%7B%22key%22%3A%22%E4%BD%9C%E6%88%98%E5%87%AD%E8%AF%81%22%2C%22value%22%3A%22%3Cp%20style%3D%5C%22white-space%3A%20pre-wrap%3B%5C%22%3E%E7%AC%AC%E5%8D%81%E4%BA%94%E6%9C%9F%EF%BC%88V4.7%EF%BC%89%E4%BD%9C%E6%88%98%E5%B7%A5%E5%9D%8A%E9%99%90%E6%97%B6%E5%85%91%E6%8D%A2%3C%2Fp%3E%22%7D%5D%7D%7D%5D\" data-ts=\"1730879474789\" data-col-type=\"l2r1\"><div style=\"order: 0;\"> <div data-part=\"info\" data-tmpl=\"weapon\" class=\"obc-tmpl__part obc-tmpl-weapon obc-tmpl__part--info obc-tmpl__part--align-banner\"><h1>武器数据</h1> <table class=\"obc-tmpl__gain-method obc-tmpl-weapon__info-table\"><colgroup><col> <col> <col></colgroup> <tbody><tr><td rowspan=\"3\" class=\"obc-tmpl-weapon__info-avatar\"><img src=\"https://uploadstatic.mihoyo.com/bh3-wiki/2021/09/07/91006211/e63ebeab40d84fa225cf2b05550bab40_9006199871180629906.png\" alt=\"\"></td> <td class=\"h3\">星级</td> <td colspan=\"5\"><div class=\"obc-tmpl-weapon__info-stars\"><i class=\"obc-tmpl__rate-icon\"></i><i class=\"obc-tmpl__rate-icon\"></i><i class=\"obc-tmpl__rate-icon\"></i><i class=\"obc-tmpl__rate-icon\"></i><i class=\"obc-tmpl__rate-icon\"></i></div></td></tr> <tr><td class=\"h3\">攻击</td> <td colspan=\"5\" class=\"obc-tmpl__rich-text\">256</td></tr><tr><td class=\"h3\">会心</td> <td colspan=\"5\" class=\"obc-tmpl__rich-text\">53</td></tr></tbody></table> <div class=\"obc-tmpl-weapon__info-desc\"><p style=\"white-space: pre-wrap;\">在某次事件之后，八重樱将自己的圣痕托付给了德丽莎，圣痕的力量和犹大的誓约产生了共鸣，改变了犹大的外形和能力。在这把武器中，铭刻着跨越500年的羁绊。这把武器的力量已被唤醒</p></div> <!----></div></div><div style=\"order: 1;\"> <div data-part=\"skill\" data-tmpl=\"weapon\" class=\"obc-tmpl__part obc-tmpl-weapon obc-tmpl__part--skill obc-tmpl__part--align-banner\"><h2>武器技能</h2> <table class=\"obc-tmpl__gain-method\"><colgroup><col> <col></colgroup> <tbody><tr><td class=\"h3\">灵刀乱神\t\t\t\t\t</td> <td colspan=\"5\" class=\"obc-tmpl__rich-text\"><p style=\"white-space: pre-wrap;\">[能量消耗:20][冷却:12秒]展开十字架【召唤物】：射出绯樱太刀，3.5秒内，每0.3秒对范围内敌人进行一段斩击，每段斩击造成180.0%攻击力的物理伤害，并有21.2%概率对敌人进行一次绯樱计数；敌人身上累计大于等于三次绯樱计数时，清空绯樱计数，并附加绯樱标记；绯樱标记持续10秒</p></td></tr><tr><td class=\"h3\">吹雪\t\t\t\t\t</td> <td colspan=\"5\" class=\"obc-tmpl__rich-text\"><p style=\"white-space: pre-wrap;\">角色有目标时，击中时有100.0%概率以目标为中心释放一个圆形范围樱花斩，造成200.0%攻击力物理伤害敌人有绯樱标记或绯樱计数时，樱花斩附加2,450点火焰伤害，樱花斩冷却时间5秒；樱火轮舞装备时，樱花斩对敌人进行一次绯樱计数</p></td></tr><tr><td class=\"h3\">束缚之键\t\t\t\t\t</td> <td colspan=\"5\" class=\"obc-tmpl__rich-text\"><p style=\"white-space: pre-wrap;\">在联机Raid关卡中，角色使用武器主动技能后，造成的雷电元素伤害提高20.0%，受到的火焰伤害降低15.0%，持续10.0秒</p></td></tr></tbody></table> <!----></div></div><div style=\"order: 2;\"> <div data-part=\"gainMethod\" data-tmpl=\"general\" class=\"obc-tmpl__part obc-tmpl-general obc-tmpl__part--gainMethod obc-tmpl__part--align-banner\"><h2>获取途径</h2> <table class=\"obc-tmpl__gain-method\"><colgroup><col> <col></colgroup> <tbody><tr><td class=\"h3\">补给获取</td> <td colspan=\"5\" class=\"obc-tmpl__rich-text\"><p style=\"white-space: pre-wrap;\">家园补给、精准补给</p></td></tr><tr><td class=\"h3\">装备锻造</td> <td colspan=\"5\" class=\"obc-tmpl__rich-text\"><p style=\"white-space: pre-wrap;\"><s>樱花的誓约真影x1</s></p><p style=\"white-space: pre-wrap;\">逆熵 · 虚数核心x150\t\t\t\t\t</p><p style=\"white-space: pre-wrap;\">以太燃素x300</p></td></tr><tr><td class=\"h3\">置换空间</td> <td colspan=\"5\" class=\"obc-tmpl__rich-text\"><p style=\"white-space: pre-wrap;\">置换空间兑换（概率刷出）</p></td></tr><tr><td class=\"h3\">大伟哥别墅</td> <td colspan=\"5\" class=\"obc-tmpl__rich-text\"><p style=\"white-space: pre-wrap;\">消耗大伟哥黑金卡获取</p></td></tr><tr><td class=\"h3\">作战凭证</td> <td colspan=\"5\" class=\"obc-tmpl__rich-text\"><p style=\"white-space: pre-wrap;\">第十五期（V4.7）作战工坊限时兑换</p></td></tr></tbody></table> <!----></div></div></div><div class=\"obc-tmpl obc-tmpl--col-l2r1\" data-data=\"%5B%7B%22tmplKey%22%3A%22stigmata%22%2C%22partKey%22%3A%22material%22%2C%22data%22%3A%7B%22layout_%22%3A%22banner%22%2C%22list%22%3A%5B%7B%22level%22%3A%2235%22%2C%22material%22%3A%5B%7B%22name%22%3A%22%E4%B8%89%E5%88%86%E7%BB%93%E6%99%B6%22%2C%22count%22%3A3%2C%22url%22%3A%22%2Fbh3%2Fwiki%2Fcontent%2F1132%2Fdetail%22%7D%2C%7B%22name%22%3A%22%E6%B5%81%E4%BD%93%E5%90%88%E9%87%91%E5%9D%97%22%2C%22count%22%3A1%2C%22url%22%3A%22%2Fbh3%2Fwiki%2Fcontent%2F1890%2Fdetail%22%7D%2C%7B%22name%22%3A%22%E7%9B%B8%E8%BD%AC%E7%A7%BB%E9%95%9C%E9%9D%A2%22%2C%22count%22%3A3%2C%22url%22%3A%22%2Fbh3%2Fwiki%2Fcontent%2F1273%2Fdetail%22%7D%5D%7D%2C%7B%22level%22%3A%2240%22%2C%22material%22%3A%5B%7B%22name%22%3A%22%E4%B8%89%E5%88%86%E7%BB%93%E6%99%B6%22%2C%22count%22%3A3%2C%22url%22%3A%22%2Fbh3%2Fwiki%2Fcontent%2F1132%2Fdetail%22%7D%2C%7B%22name%22%3A%22%E6%B5%81%E4%BD%93%E5%90%88%E9%87%91%E5%9D%97%22%2C%22count%22%3A2%2C%22url%22%3A%22%2Fbh3%2Fwiki%2Fcontent%2F1890%2Fdetail%22%7D%2C%7B%22name%22%3A%22%E7%9B%B8%E8%BD%AC%E7%A7%BB%E9%95%9C%E9%9D%A2%22%2C%22count%22%3A8%2C%22url%22%3A%22%2Fbh3%2Fwiki%2Fcontent%2F1273%2Fdetail%22%7D%5D%7D%2C%7B%22level%22%3A%2245%22%2C%22material%22%3A%5B%7B%22name%22%3A%22%E4%B8%89%E5%88%86%E7%BB%93%E6%99%B6%22%2C%22count%22%3A3%2C%22url%22%3A%22%2Fbh3%2Fwiki%2Fcontent%2F1132%2Fdetail%22%7D%2C%7B%22name%22%3A%22%E6%B5%81%E4%BD%93%E5%90%88%E9%87%91%E5%9D%97%22%2C%22count%22%3A3%2C%22url%22%3A%22%2Fbh3%2Fwiki%2Fcontent%2F1890%2Fdetail%22%7D%2C%7B%22name%22%3A%22%E7%9B%B8%E8%BD%AC%E7%A7%BB%E9%95%9C%E9%9D%A2%22%2C%22count%22%3A12%2C%22url%22%3A%22%2Fbh3%2Fwiki%2Fcontent%2F1273%2Fdetail%22%7D%5D%7D%5D%7D%7D%5D\" data-ts=\"1667210976394\" data-col-type=\"l2r1\"><div style=\"order: 0;\"> <div data-part=\"material\" data-tmpl=\"stigmata\" class=\"obc-tmpl__part obc-tmpl-stigmata obc-tmpl__part--material obc-tmpl__part--align-banner\"><h2>进化材料