9716288.png%22%7D%5D%2C%22otherMaterial%22%3A%5B%7B%22name%22%3A%22%E7%88%B1%E5%9B%A0%E6%96%AF%E5%9D%A6%E7%8E%AF%E7%A3%81%E6%9C%BA%22%2C%22num%22%3A100%2C%22url%22%3A%22%2Fbh3%2Fwiki%2Fcontent%2F1274%2Fdetail%22%7D%2C%7B%22name%22%3A%22%E8%B6%85%E5%AF%BC%E9%87%91%E5%B1%9E%E6%B0%A2%22%2C%22num%22%3A50%2C%22url%22%3A%22%2Fbh3%2Fwiki%2Fcontent%2F1140%2Fdetail%22%7D%2C%7B%22name%22%3A%22%E6%B5%81%E4%BD%93%E5%90%88%E9%87%91%E5%9D%97%22%2C%22num%22%3A4%2C%22url%22%3A%22%2Fbh3%2Fwiki%2Fcontent%2F1890%2Fdetail%22%7D%5D%7D%7D%5D\" data-ts=\"1668332802982\" data-col-type=\"l2r1\"><div style=\"order: 0;\"> <div data-part=\"info\" data-tmpl=\"weapon\" class=\"obc-tmpl__part obc-tmpl-weapon obc-tmpl__part--info obc-tmpl__part--align-banner\"><h1>武器数据</h1> <table class=\"obc-tmpl__gain-method obc-tmpl-weapon__info-table\"><colgroup><col> <col> <col></colgroup> <tbody><tr><td rowspan=\"3\" class=\"obc-tmpl-weapon__info-avatar\"><img src=\"https://uploadstatic.mihoyo.com/bh3-wiki/2021/10/22/50494840/630831a7b807aed1b9ad1d2143b9c7bd_4003350577493333061.png\" alt=\"\"></td> <td class=\"h3\">星级</td> <td colspan=\"5\"><div class=\"obc-tmpl-weapon__info-stars\"><i class=\"obc-tmpl__rate-icon\"></i><i class=\"obc-tmpl__rate-icon\"></i><i class=\"obc-tmpl__rate-icon\"></i><i class=\"obc-tmpl__rate-icon\"></i><i class=\"obc-tmpl__rate-icon\"></i><i class=\"obc-tmpl__rate-icon\"></i></div></td></tr> <tr><td class=\"h3\">攻击</td> <td colspan=\"5\" class=\"obc-tmpl__rich-text\">442</td></tr><tr><td class=\"h3\">会心</td> <td colspan=\"5\" class=\"obc-tmpl__rich-text\">18</td></tr></tbody></table> <div class=\"obc-tmpl-weapon__info-desc\"><p style=\"white-space: pre-wrap;\"><span style=\"background-color:rgb(255, 255, 255)\">少女在炽焰中窥见的，是温柔而赞许的眼神。</span></p><p style=\"white-space: pre-wrap; text-align: left;\"><span style=\"background-color:rgb(255, 255, 255)\">那眼神带来的温度，给予了她担起未来的勇气。</span></p><p style=\"white-space: pre-wrap; text-align: left;\"><span style=\"background-color:rgb(255, 255, 255)\">身后伸来的手，为她的信念增添柴薪。这意志化为煌燃的剑，点亮黑夜。</span></p><p style=\"white-space: pre-wrap;\">薪炎永煜之处，便是她们回家的方向。</p></div> <!----></div></div><div style=\"order: 1;\"> <div data-part=\"skill\" data-tmpl=\"weapon\" class=\"obc-tmpl__part obc-tmpl-weapon obc-tmpl__part--skill obc-tmpl__part--align-banner\"><h2>武器技能</h2> <table class=\"obc-tmpl__gain-method\"><colgroup><col> <col></colgroup> <tbody><tr><td class=\"h3\">煌焰灼空</td> <td colspan=\"5\" class=\"obc-tmpl__rich-text\"><p style=\"white-space: pre-wrap;\"><span style=\"background-color:#fff\">[能量消耗:0][冷却:18秒]掷出手枪在空中自动攻击敌人，每0.1秒对周围敌人造成20.0%火焰元素伤害，共计24段，同时获得4点能量，然后手枪爆炸造成750.0%火焰元素伤害。薪炎之律者使用时，额外获得以下效果：</span></p><p style=\"white-space: pre-wrap; text-align: left;\"><span style=\"background-color:#fff\">掷出时额外回复5.0点能量，爆炸时的伤害会引爆周围敌人身上的薪烬标记</span></p></td></tr><tr><td class=\"h3\">身为爝炬</td> <td colspan=\"5\" class=\"obc-tmpl__rich-text\"><p style=\"white-space: pre-wrap; text-align: left;\"><span style=\"background-color:#fff\">火焰元素伤害提高30.0%，分支攻击和必杀技全伤害提高35.0%</span></p></td></tr><tr><td class=\"h3\">薪烬不熄</td> <td colspan=\"5\" class=\"obc-tmpl__rich-text\"><p style=\"white-space: pre-wrap;\"><span style=\"background-color:rgb(255, 255, 255)\">受到主动技能爆炸伤害的敌人受到的火焰元素伤害提高15.0%，持续8.0秒，不可叠加，重复触发刷新持续时间。薪炎之律者使用时，引爆薪烬标记也可以触发这一效果</span></p></td></tr></tbody></table> <!----></div></div><div style=\"order: 2;\"> <div data-part=\"forging\" data-tmpl=\"weapon\" class=\"obc-tmpl__part obc-tmpl-weapon obc-tmpl__part--forging obc-tmpl__part--align-banner\"><h2>悬赏锻造</h2> <table class=\"obc-tmpl__gain-method\"><colgroup><col> <col></colgroup> <tbody><tr><td class=\"h3\">超限素材</td> <td colspan=\"5\"><div class=\"forging-material-td\"><div class=\"obc-tmpl__icon-text-num\"><a target=\"_blank\" href=\"/bh3/wiki/content/962/detail\"><img src=\"https://uploadstatic.mihoyo.com/bh3-wiki/2021/10/22/50494840/32c3aadeecb6898e33ccd2fa3679d567_4738257615319716288.png\" alt=\"\" class=\"obc-tmpl__icon\"><span class=\"obc-tmpl__icon-text\">解锁「焢煌之钥」图鉴后任意双枪蛋池武器</span></a> <span class=\"obc-tmpl__icon-num\">*1</span></div></div></td></tr> <tr><td class=\"h3\">其他素材</td> <td colspan=\"5\"><div class=\"forging-other-material-td\"><div class=\"obc-tmpl__icon-text-num\"><a target=\"_blank\" href=\"/bh3/wiki/content/1274/detail\"><!----><span class=\"obc-tmpl__icon-text\">爱因斯坦环磁机</span></a> <span class=\"obc-tmpl__icon-num\">*100</span></div><div class=\"obc-tmpl__icon-text-num\"><a target=\"_blank\" href=\"/bh3/wiki/content/1140/detail\"><!----><span class=\"obc-tmpl__icon-text\">超导金属氢</span></a> <span class=\"obc-tmpl__icon-num\">*50</span></div><div class=\"obc-tmpl__icon-text-num\"><a target=\"_blank\" href=\"/bh3/wiki/content/1890/detail\"><!----><span class=\"obc-tmpl__icon-text\">流体合金块</span></a> <span class=\"obc-tmpl__icon-num\">*4</span></div></div></td></tr></tbody></table> <!----></div></div></div><div class=\"obc-tmpl obc-tmpl--col-l2r1\" data-data=\"%5B%7B%22tmplKey%22%3A%22stigmata%22%2C%22partKey%22%3A%22material%22%2C%22data%22%3A%7B%22layout_%22%3A%22banner%22%2C%22list%22%3A%5B%7B%22level%22%3A%2250%22%2C%22material%22%3A%5B%7B%22name%22%3A%22%E7%88%B1%E5%9B%A0%E6%96%AF%E5%9D%A6%E7%8E%AF%E7%A3%81%E6%9C%BA%22%2C%22count%22%3A100%2C%22url%22%3A%22%2Fbh3%2Fwiki%2Fcontent%2F1274%2Fdetail%22%7D%2C%7B%22name%22%3A%22%E8%B6%85%E5%AF%BC%E9%87%91%E5%B1%9E%E6%B0%A2%22%2C%22count%22%3A100%2C%22url%22%3A%22%2Fbh3%2Fwiki%2Fcontent%2F1140%2Fdetail%22%7D%2C%7B%22name%22%3A%22%E6%B5%81%E4%BD%93%E5%90%88%E9%87%91%E5%9D%97%22%2C%22count%22%3A9%2C%22url%22%3A%22%2Fbh3%2Fwiki%2Fcontent%2F1890%2Fdetail%22%7D%5D%7D%2C%7B%22level%22%3A%2255%22%2C%22material%22%3A%5B%7B%22name%22%3A%22%E7%88%B1%E5%9B%A0%E6%96%AF%E5%9D%A6%E7%8E%AF%E7%A3%81%E6%9C%BA%22%2C%22count%22%3A100%2C%22url%22%3A%22%2Fbh3%2Fwiki%2Fcontent%2F1274%2Fdetail%22%7D%2C%7B%22name%22%3A%22%E8%B6%85%E5%AF%BC%E9%87%91%E5%B1%9E%E6%B0%A2%22%2C%22count%22%3A150%2C%22url%22%3A%22%2Fbh3%2Fwiki%2Fcontent%2F1140%2Fdetail%22%7D%2C%7B%22name%22%3A%22%E6%B5%81%E4%BD%93%E5%90%88%E9%87%91%E5%9D