E%E5%85%91%E6%8D%A2%E8%8E%B7%E5%BE%97%3C%2Fspan%3E%3C%2Fp%3E%3Cp%20style%3D%5C%22white-space%3A%20pre-wrap%3B%5C%22%3E%E5%BC%80%E5%90%AF%3Ca%20href%3D%5C%22%2Fbh3%2Fwiki%2Fcontent%2F1082%2Fdetail%5C%22%20data-type%3D%5C%22obc-content%5C%22%20target%3D%5C%22_blank%5C%22%3E%3Cspan%20style%3D%5C%22background-color%3Argba(245%2C%20247%2C%20250%2C%200.557)%5C%22%3E4%E2%98%85%E6%AD%A6%E5%99%A8%E8%87%AA%E9%80%89%E7%AE%B1%3C%2Fspan%3E%3C%2Fa%3E%3Cspan%20style%3D%5C%22background-color%3Argba(245%2C%20247%2C%20250%2C%200.557)%5C%22%3E%E5%85%91%E6%8D%A2%E8%8E%B7%E5%BE%97%3C%2Fspan%3E%3C%2Fp%3E%22%7D%2C%7B%22key%22%3A%22%E5%A4%A7%E4%BC%9F%E5%93%A5%E5%88%AB%E5%A2%85%22%2C%22value%22%3A%22%3Cp%20style%3D%5C%22white-space%3A%20pre-wrap%3B%5C%22%3E%E6%B6%88%E8%80%97%E5%A4%A7%E4%BC%9F%E5%93%A5%E9%BB%91%E9%87%91%E5%8D%A1%E5%85%91%E6%8D%A2%E8%8E%B7%E5%BE%97%3C%2Fp%3E%22%7D%5D%7D%7D%5D\" data-ts=\"1668331828193\" data-col-type=\"l2r1\"><div style=\"order: 0;\"> <div data-part=\"info\" data-tmpl=\"weapon\" class=\"obc-tmpl__part obc-tmpl-weapon obc-tmpl__part--info obc-tmpl__part--align-banner\"><h1>武器数据</h1> <table class=\"obc-tmpl__gain-method obc-tmpl-weapon__info-table\"><colgroup><col> <col> <col></colgroup> <tbody><tr><td rowspan=\"3\" class=\"obc-tmpl-weapon__info-avatar\"><img src=\"https://uploadstatic.mihoyo.com/bh3-wiki/2021/09/09/50494840/61cfbf986bdbd937dfc97c884ad8bce5_6538365489499048479.png\" alt=\"\"></td> <td class=\"h3\">星级</td> <td colspan=\"5\"><div class=\"obc-tmpl-weapon__info-stars\"><i class=\"obc-tmpl__rate-icon\"></i><i class=\"obc-tmpl__rate-icon\"></i><i class=\"obc-tmpl__rate-icon\"></i><i class=\"obc-tmpl__rate-icon\"></i><i class=\"obc-tmpl__rate-icon\"></i></div></td></tr> <tr><td class=\"h3\">攻击</td> <td colspan=\"5\" class=\"obc-tmpl__rich-text\">286</td></tr><tr><td class=\"h3\">会心</td> <td colspan=\"5\" class=\"obc-tmpl__rich-text\">31</td></tr></tbody></table> <div class=\"obc-tmpl-weapon__info-desc\"><p style=\"white-space: pre-wrap;\">曾经供奉在八重神社的灵刀·樱吹雪，在八重樱被崩坏意志控制时，斩杀了无辜的人类，被污染为了妖刀。染成鲜红色的刀身上，充盈着崩坏的力量</p></div> <!----></div></div><div style=\"order: 1;\"> <div data-part=\"skill\" data-tmpl=\"weapon\" class=\"obc-tmpl__part obc-tmpl-weapon obc-tmpl__part--skill obc-tmpl__part--align-banner\"><h2>武器技能</h2> <table class=\"obc-tmpl__gain-method\"><colgroup><col> <col></colgroup> <tbody><tr><td class=\"h3\">血色落樱</td> <td colspan=\"5\" class=\"obc-tmpl__rich-text\"><p style=\"white-space: pre-wrap;\">[能量消耗:20][冷却:21秒]斩击周围敌人造成共500%攻击力的火焰元素伤害，使用技能时角色无敌，若期间受到过攻击则最后一段斩击额外造成200%攻击力的火焰元素伤害。之后，角色获得屏障，在5秒内完全抵挡一次攻击伤害，抵挡后屏障消失</p><p style=\"white-space: pre-wrap;\">真炎幸魂装备时，被该技能命中的敌人受到的火焰元素伤害提高25%，冰冻和雷电元素伤害提高10%，持续15秒（ 不与分支追击相应效果叠加 )</p></td></tr><tr><td class=\"h3\">真炎</td> <td colspan=\"5\" class=\"obc-tmpl__rich-text\"><p style=\"white-space: pre-wrap;\">角色攻击造成的火焰元素伤害提高40%</p></td></tr></tbody></table> <!----></div></div><div style=\"order: 2;\"> <div data-part=\"gainMethod\" data-tmpl=\"general\" class=\"obc-tmpl__part obc-tmpl-general obc-tmpl__part--gainMethod obc-tmpl__part--align-banner\"><h2>获取方式</h2> <table class=\"obc-tmpl__gain-method\"><colgroup><col> <col></colgroup> <tbody><tr><td class=\"h3\">补给获取</td> <td colspan=\"5\" class=\"obc-tmpl__rich-text\"><p style=\"white-space: pre-wrap;\">家园补给、精准补给、活动补给</p></td></tr><tr><td class=\"h3\">装备锻造</td> <td colspan=\"5\" class=\"obc-tmpl__rich-text\"><p style=\"white-space: pre-wrap;\">妖刀 · 赤染樱真影×1</p><p style=\"white-space: pre-wrap;\"><a href=\"/bh3/wiki/content/1136/detail\" data-type=\"obc-content\" target=\"_blank\">逆熵 · 虚数核心</a>×150</p><p style=\"white-space: pre-wrap;\"><a href=\"/bh3/wiki/content/1143/detail\" data-type=\"obc-content\" target=\"_blank\">以太燃素</a>×300</p></td></tr><tr><td class=\"h3\">置换空间</td> <td colspan=\"5\" class=\"obc-tmpl__rich-text\"><p style=\"white-space: pre-wrap;\">置换空间兑换（概率刷出）</p></td></tr><tr><td class=\"h3\">消耗品</td> <td colspan=\"5\" class=\"obc-tmpl__rich-text\"><p style=\"white-space: pre-wrap;\"><span style=\"background-color:rgb(255, 255, 255)\">开启</span><a href=\"/bh3/wiki/content/1204/detail\" data-type=\"obc-content\" target=\"_blank\"><span style=\"background-color:rgb(255, 255, 255)\">4★太刀武器自选箱</span></a><span style=\"background-color:rgb(255, 255, 255)\">兑换获得</span></p><p style=\"white-space: pre-wrap;\">开启<a href=\"/bh3/wiki/content/1082/detail\" data-type=\"obc-content\" target=\"_blank\"><span style=\"background-color:rgba(245, 247, 250, 0.557)\">4★武器自选箱</span></a><span style=\"background-color:rgba(245, 247, 250, 0.557)\">兑换获得</span></p></td></tr><tr><td class=\"h3\">大伟哥别墅</td> <td colspan=\"5\" class=\"obc-tmpl__rich-text\"><p style=\"white-space: pre-wrap;\">消耗大伟哥黑金卡兑换获得</p></td></tr></tbody></table> <!----></div></div></div><div class=\"obc-tmpl obc-tmpl--col-l2r1\" data-data=\"%5B%7B%22tmplKey%22%3A%22stigmata%22%2C%22partKey%22%3A%22material%22%2C%22data%22%3A%7B%22layout_%22%3A%22banner%22%2C%22list%22%3A%5B%7B%22level%22%3A%2235%22%2C%22material%22%3A%5B%7B%22name%22%3A%22%E4%B8%89%E5%88%86%E7%BB%93%E6%99%B6%22%2C%22count%22%3A3%2C%22url%22%3A%22%2Fbh3%2Fwiki%2Fcontent%2F1132%2Fdetail%22%7D%2C%7B%22name%22%3A%22%E6%B5%81%E4%BD%93%E5%90%88%E9%87%91%E5%9D%97%22%2C%22count%22%3A1%2C%22url%22%3A%22%2Fbh3%2Fwiki%2Fcontent%2F1890%2Fdetail%22%7D%2C%7B%22name%22%3A%22%E7%9B%B8%E8%BD%AC%E7%A7%BB%E9%95%9C%E9%9D%A2%22%2C%22count%22%3A3%2C%22url%22%3A%22%2Fbh3%2Fwiki%2Fcontent%2F1273%2Fdetail%22%7D%5D%7D%2C%7B%22level%22%3A%2240%22%2C%22material%22%3A%5B%7B%22name%22%3A%22%E4%B8%89%E5%88%86%E7%BB%93%E6%99%B6%22%2C%22count%22%3A3%2C%22url%22%3A%22%2Fbh3%2Fwiki%2Fcontent%2F1132%2Fdetail%22%7D%2C%7B%22name%22%3A%22%E6%B5%81%E4%BD%93%E5%90%88%E9%87%91%E5%9D%97%22%2C%22count%22%3A2%2C%22url%22%3A%22%2Fbh3%2Fwiki%2Fcontent%2F1890%2Fdetail%22%7D%2C%7B%22name%22%3A%22%E7%9B%B8%E8%BD%AC%E7%A7%BB%E9%95%9C%E9%9D%A2%22%2C%22count%22%3A8%2C%22url%22%3A%22%2Fbh3%2Fwiki%2Fcontent%2F1273%2Fdetail%22%7D%5D%7D%2C%7B%22level%22%3A%2245%22%2C%22material%22%3A%5B%7B%22name%22%3A%22%E4%B8%89%E5%88%86%E7%BB%9