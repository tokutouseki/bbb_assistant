3Fbbs_presentation_style%3Dno_header%5C%22%20data-type%3D%5C%22obc-content%5C%22%20target%3D%5C%22_blank%5C%22%3E%E7%A5%9E%E4%B9%8B%E9%94%AE%E8%87%AA%E9%80%89%E7%AE%B1%3C%2Fa%3E%E5%85%91%E6%8D%A2%E8%8E%B7%E5%BE%97%3C%2Fp%3E%22%7D%5D%7D%7D%5D\" data-ts=\"1753375639977\" data-col-type=\"l2r1\"><div style=\"order: 0;\"> <div data-part=\"info\" data-tmpl=\"weapon\" class=\"obc-tmpl__part obc-tmpl-weapon obc-tmpl__part--info obc-tmpl__part--align-banner\"><h1>武器数据</h1> <table class=\"obc-tmpl__gain-method obc-tmpl-weapon__info-table\"><colgroup><col> <col> <col></colgroup> <tbody><tr><td rowspan=\"3\" class=\"obc-tmpl-weapon__info-avatar\"><img src=\"https://uploadstatic.mihoyo.com/bh3-wiki/2021/09/07/77124895/21af66a8dec4192ea6220e0d52c5964b_5004830300900279373.png\" alt=\"\"></td> <td class=\"h3\">星级</td> <td colspan=\"5\"><div class=\"obc-tmpl-weapon__info-stars\"><i class=\"obc-tmpl__rate-icon\"></i><i class=\"obc-tmpl__rate-icon\"></i><i class=\"obc-tmpl__rate-icon\"></i><i class=\"obc-tmpl__rate-icon\"></i><i class=\"obc-tmpl__rate-icon\"></i></div></td></tr> <tr><td class=\"h3\">攻击</td> <td colspan=\"5\" class=\"obc-tmpl__rich-text\">276</td></tr><tr><td class=\"h3\">会心</td> <td colspan=\"5\" class=\"obc-tmpl__rich-text\">32</td></tr></tbody></table> <div class=\"obc-tmpl-weapon__info-desc\"><p style=\"white-space: pre-wrap;\">上一个时代文明留下来的超神兵，利用崩坏能自在的控制雷，火，冰三种元素之力，其力量远超这个时代人类的认知水平。这把武器真正的力量还在沉睡，但在未来某个时候，它将被唤醒</p></div> <!----></div></div><div style=\"order: 1;\"> <div data-part=\"skill\" data-tmpl=\"weapon\" class=\"obc-tmpl__part obc-tmpl-weapon obc-tmpl__part--skill obc-tmpl__part--align-banner\"><h2>武器技能</h2> <table class=\"obc-tmpl__gain-method\"><colgroup><col> <col></colgroup> <tbody><tr><td class=\"h3\">元素爆发</td> <td colspan=\"5\" class=\"obc-tmpl__rich-text\"><p style=\"white-space: pre-wrap;\">[能量消耗:9][冷却:12秒]连续使用可依次放出雷电、火焰与冰冻元素的招式，各造成240%物理与240%相应元素叠加的伤害，分别可造成5点麻痹、点燃与冻结积蓄值；技能可充能三次；<br>使用主动技后一段时间内(雷火冰分别4秒、7秒、10秒)，自身周围一定范围内的敌人每1秒受到落雷、陨石与落冰攻击，造成100%攻击力的元素伤害。</p></td></tr><tr><td class=\"h3\">轩辕守护</td> <td colspan=\"5\" class=\"obc-tmpl__rich-text\"><p style=\"white-space: pre-wrap;\">蓄力攻击全伤害提高25%。被攻击或极限闪避后，向目标敌人发射两发灵体轩辕剑，穿透并击飞沿途敌人并造成200%攻击力的物理伤害，冷却时间10秒。</p></td></tr><tr><td class=\"h3\">支配之键</td> <td colspan=\"5\" class=\"obc-tmpl__rich-text\"><p style=\"white-space: pre-wrap;\">在联机Raid关卡中，角色使用武器主动技能后，全队造成的元素伤害提高20.0%，受到的全元素伤害降低15.0%，持续6.0秒</p></td></tr></tbody></table> <!----></div></div><div style=\"order: 2;\"> <div data-part=\"gainMethod\" data-tmpl=\"general\" class=\"obc-tmpl__part obc-tmpl-general obc-tmpl__part--gainMethod obc-tmpl__part--align-banner\"><h2>获取方式</h2> <table class=\"obc-tmpl__gain-method\"><colgroup><col> <col></colgroup> <tbody><tr><td class=\"h3\">补给获取</td> <td colspan=\"5\" class=\"obc-tmpl__rich-text\"><p style=\"white-space: pre-wrap;\">活动补给</p></td></tr><tr><td class=\"h3\">大伟哥别墅</td> <td colspan=\"5\" class=\"obc-tmpl__rich-text\"><p style=\"white-space: pre-wrap;\"><span style=\"background-color:rgb(251, 253, 255)\">消耗</span><a href=\"https://baike.mihoyo.com/bh3/wiki/content/1180/detail\" data-type=\"obc-content\" target=\"_blank\">大伟哥黑金卡</a><span style=\"background-color:rgb(251, 253, 255)\">兑换获得</span></p></td></tr><tr><td class=\"h3\">材料-消耗品</td> <td colspan=\"5\" class=\"obc-tmpl__rich-text\"><p style=\"white-space: pre-wrap;\">开启<a href=\"/bh3/wiki/content/3513/detail?bbs_presentation_style=no_header\" data-type=\"obc-content\" target=\"_blank\">神之键自选箱</a>兑换获得</p></td></tr></tbody></table> <!----></div></div></div><div class=\"obc-tmpl obc-tmpl--col-l2r1\" data-data=\"%5B%7B%22tmplKey%22%3A%22stigmata%22%2C%22partKey%22%3A%22material%22%2C%22data%22%3A%7B%22layout_%22%3A%22banner%22%2C%22list%22%3A%5B%7B%22level%22%3A%2235%22%2C%22material%22%3A%5B%7B%22name%22%3A%22%E4%B8%89%E5%88%86%E7%BB%93%E6%99%B6%22%2C%22count%22%3A3%2C%22url%22%3A%22%2Fbh3%2Fwiki%2Fcontent%2F1132%2Fdetail%22%7D%2C%7B%22name%22%3A%22%E6%B5%81%E4%BD%93%E5%90%88%E9%87%91%E5%9D%97%22%2C%22count%22%3A1%2C%22url%