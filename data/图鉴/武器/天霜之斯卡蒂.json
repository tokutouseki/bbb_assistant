6%B3%9B%E7%94%A8%E6%80%A7%EF%BC%8C%E5%AE%8C%E7%BE%8E%E5%A5%91%E5%90%88%E4%BE%9D%E8%B5%96%E5%BC%80%E5%90%AF%E7%88%86%E5%8F%91%E7%8A%B6%E6%80%81%E8%BE%93%E5%87%BA%E7%9A%84%E6%9C%88%E9%AD%82%EF%BC%8C%E4%B9%9F%E5%90%8C%E6%A0%B7%E5%8F%AF%E4%BB%A5%E7%BB%99%E4%BE%9D%E8%B5%96SP%E6%89%93%E7%88%86%E5%8F%91%E8%BE%93%E5%87%BA%E7%9A%84%E5%B9%BB%E6%B5%B7%E6%A2%A6%E8%9D%B6%E3%80%81%E9%AD%87%E5%A4%9C%E6%98%9F%E6%B8%8A%E4%BD%9C%E4%B8%BA%E4%B8%8B%E4%BD%8D%E6%9B%BF%E4%BB%A3%E6%AD%A6%E5%99%A8%E4%BD%BF%E7%94%A8%EF%BC%8C%E5%9C%A8%E6%B7%B1%E6%B8%8A%E7%8E%AF%E5%A2%83%E4%B8%8B%E8%A1%A8%E7%8E%B0%E9%9D%9E%E5%B8%B8%E4%BC%98%E7%A7%80%E7%9A%84%E4%B8%80%E6%8A%8A%E6%AD%A6%E5%99%A8%E3%80%82%3C%2Fp%3E%22%7D%7D%5D\" data-ts=\"1635319350506\" data-col-type=\"l2r1\" contenteditable=\"false\" draggable=\"true\" data-empty-text=\"\"><div style=\"order: 0;\"> <div data-part=\"role\" data-tmpl=\"weapon\" class=\"obc-tmpl__part obc-tmpl-weapon obc-tmpl__part--role obc-tmpl__part--align-banner\"><h2>适用角色</h2> <table class=\"obc-tmpl__gain-method obc-tmpl-weapon__role-table\"><colgroup><col> <col></colgroup> <tbody><tr><td class=\"h3\"><div class=\"role-icon-td\"><div><img src=\"https://uploadstatic.mihoyo.com/bh3-wiki/2021/09/27/72350798/fcda1323133f47f99c6a0143f9e223c3_3194606462856006353.png\" alt=\"\"></div> <span>苍骑士·月魂</span></div></td> <td><div class=\"obc-tmpl-weapon__role-stars\"><span>推荐指数</span> <div><i class=\"obc-tmpl__rate-icon\"></i><i class=\"obc-tmpl__rate-icon\"></i><i class=\"obc-tmpl__rate-icon\"></i><i class=\"obc-tmpl__rate-icon\"></i><i class=\"obc-tmpl__rate-icon\"></i></div></div></td> <td colspan=\"3\" class=\"obc-tmpl__rich-text\"><p style=\"white-space: pre-wrap;\">月魂的毕业武器，提高冰伤和维持循环所需的续航能力</p></td></tr><tr><td class=\"h3\"><div class=\"role-icon-td\"><div><img src=\"https://uploadstatic.mihoyo.com/bh3-wiki/2021/09/27/72350798/e27bbe77661ed529137be1ae68f0f180_6832736825937089107.png\" alt=\"\"></div> <span>餍夜星渊</span></div></td> <td><div class=\"obc-tmpl-weapon__role-stars\"><span>推荐指数</span> <div><i class=\"obc-tmpl__rate-icon\"></i><i class=\"obc-tmpl__rate-icon\"></i><i class=\"obc-tmpl__rate-icon\"></i><i class=\"obc-tmpl__rate-icon obc-tmpl__rate-icon--inactive\"></i><i class=\"obc-tmpl__rate-icon obc-tmpl__rate-icon--inactive\"></i></div></div></td> <td colspan=\"3\" class=\"obc-tmpl__rich-text\"><p style=\"white-space: pre-wrap;\">冰伤加成及开启大招的能量回复同样适合冰希</p></td></tr></tbody></table> <!----></div></div><div style=\"order: 1;\"> <div data-part=\"review\" data-tmpl=\"weapon\" class=\"obc-tmpl__part obc-tmpl-weapon obc-tmpl__part--review obc-tmpl__part--align-banner\"><h2>武器测评</h2> <div class=\"obc-tmpl-valkyrie__skill-container\"><div><img src=\"https://uploadstatic.mihoyo.com/bh3-wiki/2021/09/09/72350798/2932b927e6e51732f8f7655fcc9c00a4_421638863698291081.gif\" class=\"mobile-gif\"></div> <div class=\"obc-tmpl-valkyrie__skill-item\"><div class=\"obc-tmpl-valkyrie__skill-item-desc\"><div class=\"text\"><p style=\"white-space: pre-wrap;\">天霜之斯卡蒂属于一把具有自己特色的合格超限武器。除了能显著地提升冰伤角色的输出以外，开启必杀技时返还SP以及击中敌人获取额外SP的特性使其具有相当高的泛用性，完美契合依赖开启爆发状态输出的月魂，也同样可以给依赖SP打爆发输出的幻海梦蝶、魇夜星渊作为下位替代武器使用，在深渊环境下表现非常优秀的一把武器。</p></div> <div class=\"obc-tmpl-valkyrie__skill-item-desc-gif\" style=\"padding: 0px;\"><img src=\"https://uploadstatic.mihoyo.com/bh3-wiki/2021/09/09/72350798/2932b927e6e51732f8f7655fcc9c00a4_421638863698291081.gif\" alt=\"\"></div></div></div></div> <!----></div></div></div></div></div> <div data-v-f0365338=\"\" class=\"detail__body-endpart\"><hr data-v-f0365338=\"\"> <p data-v-f0365338=\"\" class=\"detail__copyright\"><img data-v-f0365338=\"\" src=\"data:image/png;base64,\">\n        词条内容由圣芙蕾雅档案馆编辑团队原创，禁止转载\n      </p></div> <!---->",
