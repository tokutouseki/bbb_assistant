D10%E7%A7%92%EF%BC%8C%E9%87%8D%E5%A4%8D%E8%A7%A6%E5%8F%91%E5%88%B7%E6%96%B0%E6%8C%81%E7%BB%AD%E6%97%B6%E9%97%B4%E3%80%82%E6%AC%A1%E7%94%9F%E9%93%B6%E7%BF%BC%E4%BD%BF%E7%94%A8%E6%97%B6%EF%BC%8C%E7%A9%BF%E8%BF%87%E5%88%86%E8%A3%82%E5%B1%8F%E9%9A%9C%E7%9A%84%E5%BC%BA%E5%8C%96%E8%83%BD%E9%87%8F%E5%BC%B9%E9%80%A0%E6%88%90%E5%86%B0%E5%86%BB%E5%85%83%E7%B4%A0%E4%BC%A4%E5%AE%B3%E6%8F%90%E9%AB%9840.0%25%3C%2Fspan%3E%3C%2Fp%3E%22%7D%5D%7D%7D%2C%7B%22tmplKey%22%3A%22weapon%22%2C%22partKey%22%3A%22forging%22%2C%22data%22%3A%7B%22layout_%22%3A%22banner%22%2C%22material%22%3A%5B%7B%22name%22%3A%22%E8%A7%A3%E9%94%81%E3%80%8C%E8%93%9D%E7%84%B0%E9%93%B6%E9%9A%BC0019%E3%80%8D%E5%9B%BE%E9%89%B4%E5%90%8E%E4%BB%BB%E6%84%8F%E9%87%8D%E7%82%AE%E8%9B%8B%E6%B1%A0%E6%AD%A6%E5%99%A8%22%2C%22num%22%3A1%2C%22url%22%3A%22%2Fbh3%2Fwiki%2Fcontent%2F1336%2Fdetail%22%2C%22icon%22%3A%22https%3A%2F%2Fuploadstatic.mihoyo.com%2Fbh3-wiki%2F2021%2F12%2F06%2F50494840%2F0270b3cb79ae6697864589ad3b3f1f65_1718829478957287820.png%22%7D%5D%2C%22otherMaterial%22%3A%5B%7B%22name%22%3A%22%E7%88%B1%E5%9B%A0%E6%96%AF%E5%9D%A6%E7%8E%AF%E7%A3%81%E6%9C%BA%22%2C%22num%22%3A100%2C%22url%22%3A%22%2Fbh3%2Fwiki%2Fcontent%2F1274%2Fdetail%22%7D%2C%7B%22name%22%3A%22%E8%B6%85%E5%AF%BC%E9%87%91%E5%B1%9E%E6%B0%A2%22%2C%22num%22%3A50%2C%22url%22%3A%22%2Fbh3%2Fwiki%2Fcontent%2F1140%2Fdetail%22%7D%2C%7B%22name%22%3A%22%E6%B5%81%E4%BD%93%E5%90%88%E9%87%91%E5%9D%97%22%2C%22num%22%3A4%2C%22url%22%3A%22%2Fbh3%2Fwiki%2Fcontent%2F1890%2Fdetail%22%7D%5D%7D%7D%5D\" data-ts=\"1668332680670\" data-col-type=\"l2r1\"><div style=\"order: 0;\"> <div data-part=\"info\" data-tmpl=\"weapon\" class=\"obc-tmpl__part obc-tmpl-weapon obc-tmpl__part--info obc-tmpl__part--align-banner\"><h1>武器数据</h1> <table class=\"obc-tmpl__gain-method obc-tmpl-weapon__info-table\"><colgroup><col> <col> <col></colgroup> <tbody><tr><td rowspan=\"3\" class=\"obc-tmpl-weapon__info-avatar\"><img src=\"https://uploadstatic.mihoyo.com/bh3-wiki/2021/12/06/50494840/bb5902c67d0e18fdd0478c24d0191cad_1688914031083462259.png\" alt=\"\"></td> <td class=\"h3\">星级</td> <td colspan=\"5\"><div class=\"obc-tmpl-weapon__info-stars\"><i class=\"obc-tmpl__rate-icon\"></i><i class=\"obc-tmpl__rate-icon\"></i><i class=\"obc-tmpl__rate-icon\"></i><i class=\"obc-tmpl__rate-icon\"></i><i class=\"obc-tmpl__rate-icon\"></i><i class=\"obc-tmpl__rate-icon\"></i></div></td></tr> <tr><td class=\"h3\">攻击</td> <td colspan=\"5\" class=\"obc-tmpl__rich-text\">433</td></tr><tr><td class=\"h3\">会心</td> <td colspan=\"5\" class=\"obc-tmpl__rich-text\">25</td></tr></tbody></table> <div class=\"obc-tmpl-weapon__info-desc\"><p style=\"white-space: pre-wrap; text-align: left;\">新生 · 圣1504研究所出品，主理人「长光18th」灵魂之作，炮身采用德克勒苍芯魂钢，机器鎏银工艺，旧化效果迷人。目前陈列于E · T</p><p style=\"white-space: pre-wrap;\">Studio总部展示厅，由两位员工专人维护，每月一次清理，每季度两次护理，欢迎预约参观。</p><p style=\"white-space: pre-wrap;\">“请别用武器来定义圣1504的劳动成果。”既是古典文化的传承，又有符合时代的潮流审美蕴含其中——这正是二十一世纪的「长光精神」。</p><p style=\"white-space: pre-wrap; text-align: left;\"><span style=\"background-color:#fff\">“我不是说它不好，无论从哪个角度，它都是一件精致的艺术品，也正因如此</span><span style=\"background-color:rgb(255, 255, 255)\">······</span><span style=\"background-color:#fff\">你看，我都不怎么使用它。”——《到底是人用武器还是武器用人？阿拉哈托制作人：对高层和合作伙伴已经失去信心。原理工作室或将解散》</span></p></div> <!----></div></div><div style=\"order: 1;\"> <div data-part=\"skill\" data-tmpl=\"weapon\" class=\"obc-tmpl__part obc-tmpl-weapon obc-tmpl__part--skill obc-tmpl__part--align-banner\"><h2>武器技能</h2> <table class=\"obc-tmpl__gain-method\"><colgroup><col> <col></colgroup> <tbody><tr><td class=\"h3\">霜翼新星</td> <td colspan=\"5\" class=\"obc-tmpl__rich-text\"><p style=\"white-space: pre-wrap; text-align: left;\"><span style=\"background-color:rgb(255, 255, 255)\">蓄力炮，一层：单发炮弹，二层：双发更强炮弹，三层：三发超强炮弹。角色全伤害提高40.0%，使用QTE造成伤害时提高全场目标受到的冰冻元素伤害20.0%，持续10秒，效果持续期间，角色使用必杀技命中目标时，效果延长10秒，每个目标最多延长1次（该效果唯一生效，不可叠加）</span></p></td></tr><tr><td class=\"h3\">坍噬羽弹</td> <td colspan=\"5\" class=\"obc-tmpl__rich-text\"><p style=\"white-space: pre-wrap;\"><span style=\"background-color:rgb(255, 255, 255)\">[能量消耗:0][冷却:16秒]角色向摇杆方向冲锋一段距离后召唤武器，发射一发能量弹，命中目标后造成400%攻击力的冰冻元素范围伤害。能量弹穿过次生银翼的分裂屏障后会变为强化能量弹，命中目标造成400%攻击力的冰冻元素伤害，并产生一个大范围黑洞，持续吸引周围敌人，造成30*10.0%攻击力的冰冻元素伤害，随后爆炸，造成500.0%攻击力的冰冻元素伤害，强化能量弹命中时减少武器技能3.0秒冷却时间。次生银翼使用时，释放武器技能后可以直接衔接普通攻击地面第四段或空中第三段</span></p></td></tr><tr><td class=\"h3\">零度立场</td> <td colspan=\"5\" class=\"obc-tmpl__rich-text\"><p style=\"white-space: pre-wrap;\"><span style=\"background-color:rgb(255, 255, 255)\">使用武器技能或必杀技时自身冰冻元素伤害提高40.0%，持续10秒，重复触发刷新持续时间。次生银翼使用时，穿过分裂屏障的强化能量弹造成冰冻元素伤害提高40.0%</span></p></td></tr></tbody></table> <!----></div></div><div style=\"order: 2;\"> <div data-part=\"forging\" data-tmpl=\"weapon\" class=\"obc-tmpl__part obc-tmpl-weapon obc-tmpl__part--forging obc-tmpl__part--align-banner\"><h2>悬赏锻造</h2> <table class=\"obc-tmpl__gain-method\"><colgroup><col> <col></colgroup> <tbody><tr><td class=\"h3\">超限素材</td> <td colspan=\"5\"><div class=\"forging-material-td\"><div class=\"obc-tmpl__icon-text-num\"><a target=\"_blank\" href=\"/bh3/wiki/content/1336/detail\"><img src=\"https://uploadstatic.mihoyo.com/bh3-wiki/2021/12/06/50494840/0270b3cb79ae6697864589ad3b3f1f65_1718829478957287820.png\" alt=\"\" class=\"obc-tmpl__icon\"><span class=\"obc-tmpl__icon-text\">解锁「蓝焰银隼0019」图鉴后任意重炮蛋池武器</span></a> <span class=\"obc-tmpl__icon-num\">*1</span></div></div></td></tr> <tr><td class=\"h3\">其他素材</td> <td colspan=\"5\"><div class=\"forging-other-material-td\"><div class=\"obc-tmpl__icon-text-num\"><a target=\"_blank\" href=\"/bh3/wiki/content/1274/detail\"><!----><span class=\"obc-tmpl__icon-text\">爱因斯坦环磁机</span></a> <span class=\"obc-tmpl__icon-num\">*100</span></div><div class=\"obc-tmpl__icon-text-num\"><a target=\"_blank\" href=\"/bh3/wiki/content/1140/detail\"><!----><span class=\"obc-tmpl__icon-text\">超导金属氢</span></a> <span class=\"obc-tmpl__icon-num\">*50</span></div><div class=\"obc-tmpl__icon-text-num\"><a target=\"_blank\" href=\"/bh3/wiki/content/1890/detail\"><!----><span class=\"obc-tmpl__icon-text\">流体合金块</span></a> <span class=\"obc-tmpl__icon-num\">*4</span></div></div></td></tr></tbody></table> <!----></div></div></div><div class=\"obc-tmpl obc-tmpl--col-l2r1\" data-data=\"%5B%7B%22tmplKey%22%3A%22stigmata%22%2C%22partKey%22%3A%22material%22%2C%22data%22%3A%7B%22layout_%22%3A%22banner%22%2C%22list%22%3A%5B%7B%22level%22%3A%2250%22%2C%22material%22%3A%5B%7B%22name%22%3A%22%E7%88%B1%E5%9B%A0%E6%96%AF%E5%9D%A6%E7%8E%AF%E7%A3%81%E6%9C%BA%22%2C%22count%22%3A100%2C%22url%22%3A%22%2Fbh3%2Fwiki%2Fcontent%2F1274%2Fdetail%22%7D%2C%7B%22name%22%3A%22%E8%B6%85%E5%AF%BC%E9%87%91%E5%B1%9E%E6%B0%A2%22%2C%22count%22%3A100%2C%22url%22%3A%22%2Fbh3%2Fwiki%2Fcontent%2F1140%2Fdetail%22%7D%2C%7B%22name%22%3A%22%E6%B5%81%E4%BD%93%E5%90%88%E9%87%91%E5%9D%97%22%2C%22count%22%3A9%2C%22url%22%3A%22%2Fbh3%2Fwiki%2Fcontent%2F1890%2Fdetail%22%7D%5D%7D%2C%7B%22level%22%3A%2255%22%2C%22material%22%3A%5B%7B%22name%22%3A%22%E7%88%B1%E5%9B%A0%E6%96%AF%E5%9D%A6%E7%8E%AF%E7%A3%81%E6%9C%BA%22%2C%22count%22%3A100%2C%22url%22%3A%22%2Fbh3%2Fwiki%2Fcontent%2F1274%2Fdetail%22%7D%2C%7B%22name%22%3A%22%E8%B6%85%E5%AF%BC%E9%87%91%E5%B1%9E%E6%B0%A2%22%2C%22count%22%3A150%2C%22url%22%3A%22%2Fbh3%2Fwiki%2Fcontent%2F1140%2Fdetail%22%7D%2C%7B%22name%22%3A%22%E6%B5%81%E4%BD%93%E5%90%88%E9%87%91%E5%9D%97%22%2C%22count%22%3A14%2C%22url%22%3A%22%2Fbh3%2Fwiki%2Fcontent%2F1890%2Fdetail%22%7D%5D%7D%2C%7B%22level%22%3A%2260%22%2C%22material%22%3A%5B%7B%22name%22%3A%22%E7%88%B1%E5%9B%A0%E6%96%AF%E5%9D%A6%E7%8E%AF%E7%A3%81%E6%9C%BA%22%2C%22count%22%3A100%2C%22url%22%3A%22%2Fbh3%2Fwiki%2Fcontent%2F1274%2Fdetail%22%7D%2C%7B%22name%22%3A%22%E8%B6%85%E5%AF%BC%E9%87%91%E5%B1%9E%E6%B0%A2%22%2C%22count%22%3A220%2C%22url%22%3A%22%2Fbh3%2Fwiki%2Fcontent%2F1140%2Fdetail%22%7D%2C%7B%22name%22%3A%22%E6%B5%81%E4%BD%93%E5%90%88%E9%87%91%E5%9D%97%22%2C%22count%22%3A18%2C%22url%22%3A%22%2Fbh3%2Fwiki%2Fcontent%2F1890%2Fdetail%22%7D%5D%7D%5D%7D%7D%5D\" data-ts=\"1667832433362\" data-col-type=\"l2r1\" contenteditable=\"false\" draggable=