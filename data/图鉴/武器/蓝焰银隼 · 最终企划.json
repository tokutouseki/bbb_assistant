%8C%E5%B9%B6%E4%B8%94%E5%86%B0%E4%BC%A4%E9%87%8D%E7%82%AE%E8%B6%85%E9%99%90%E6%AD%A6%E5%99%A8%E4%BD%9C%E4%B8%BA%E4%B8%8B%E4%BD%8D%E6%9B%BF%E4%BB%A3%E6%97%B6%E4%B9%9F%E6%98%BE%E5%BE%97%E6%9B%B4%E5%8A%A0%E4%BC%98%E7%A7%80%E3%80%82%3C%2Fp%3E%22%7D%7D%5D\" data-ts=\"1672924187852\" data-col-type=\"l2r1\"><div style=\"order: 0;\"> <div data-part=\"role\" data-tmpl=\"weapon\" class=\"obc-tmpl__part obc-tmpl-weapon obc-tmpl__part--role obc-tmpl__part--align-banner\"><h2>适用角色</h2> <table class=\"obc-tmpl__gain-method obc-tmpl-weapon__role-table\"><colgroup><col> <col></colgroup> <tbody><tr><td class=\"h3\"><div class=\"role-icon-td\"><div><img src=\"https://uploadstatic.mihoyo.com/bh3-wiki/2023/01/05/50494840/7acddd6325e170fdc3f7dfba7c65dece_6349896643671819113.png\" alt=\"\"></div> <span>次生银翼</span></div></td> <td><div class=\"obc-tmpl-weapon__role-stars\"><span>推荐指数</span> <div><i class=\"obc-tmpl__rate-icon\"></i><i class=\"obc-tmpl__rate-icon\"></i><i class=\"obc-tmpl__rate-icon\"></i><i class=\"obc-tmpl__rate-icon\"></i><i class=\"obc-tmpl__rate-icon\"></i></div></div></td> <td colspan=\"3\" class=\"obc-tmpl__rich-text\"><p style=\"white-space: pre-wrap;\">推荐武器，全方面提高输出和循环能力。</p></td></tr><tr><td class=\"h3\"><div class=\"role-icon-td\"><div><img src=\"https://uploadstatic.mihoyo.com/bh3-wiki/2021/12/07/50494840/ffe644bd93b8add1c3cb81b48b1bc5d1_2535066504101726327.png\" alt=\"\"></div> <span>理之律者</span></div></td> <td><div class=\"obc-tmpl-weapon__role-stars\"><span>推荐指数</span> <div><i class=\"obc-tmpl__rate-icon\"></i><i class=\"obc-tmpl__rate-icon\"></i><i class=\"obc-tmpl__rate-icon\"></i><i class=\"obc-tmpl__rate-icon\"></i><i class=\"obc-tmpl__rate-icon obc-tmpl__rate-icon--inactive\"></i></div></div></td> <td colspan=\"3\" class=\"obc-tmpl__rich-text\"><p style=\"white-space: pre-wrap;\">提高伤害，没有真理之境：启示的可行性选择。</p></td></tr><tr><td class=\"h3\"><div class=\"role-icon-td\"><div><img src=\"https://uploadstatic.mihoyo.com/bh3-wiki/2021/12/07/50494840/0f577990b025b4695221ff233b02a53d_5898794022051930699.png\" alt=\"\"></div> <span>迷城骇兔</span></div></td> <td><div class=\"obc-tmpl-weapon__role-stars\"><span>推荐指数</span> <div><i class=\"obc-tmpl__rate-icon\"></i><i class=\"obc-tmpl__rate-icon\"></i><i class=\"obc-tmpl__rate-icon\"></i><i class=\"obc-tmpl__rate-icon\"></i><i class=\"obc-tmpl__rate-icon obc-tmpl__rate-icon--inactive\"></i></div></div></td> <td colspan=\"3\" class=\"obc-tmpl__rich-text\"><p style=\"white-space: pre-wrap;\">提高伤害，QTE产生的易伤具有一定的辅助能力。</p></td></tr></tbody></table> <!----></div></div><div style=\"order: 1;\"> <div data-part=\"review\" data-tmpl=\"weapon\" class=\"obc-tmpl__part obc-tmpl-weapon obc-tmpl__part--review obc-tmpl__part--align-banner\"><h2>武器测评</h2> <div class=\"obc-tmpl-valkyrie__skill-container\"><div><img src=\"https://uploadstatic.mihoyo.com/bh3-wiki/2021/12/12/50494840/424f3da584cc9c9424b23a1d3d23502f_237394827728215174.gif\" class=\"mobile-gif\"></div> <div class=\"obc-tmpl-valkyrie__skill-item\"><div class=\"obc-tmpl-valkyrie__skill-item-desc\"><div class=\"text\"><p style=\"white-space: pre-wrap;\">提高全伤，使用武器技能或必杀技时提高冰伤，QTE造成伤害时可产生易伤，具有一定辅助能力；</p><p style=\"white-space: pre-wrap;\">武器的主动和被动都高度与次生银翼适配，武器主动穿过屏障后具有吸引敌人和高频的特性，并且释放主动后衔接普攻的机制可改善循环能力；</p><p style=\"white-space: pre-wrap;\">理之律者使用时基本的数值都可以与之相契合，并且冰伤重炮超限武器作为下位替代时也显得更加优秀。</p></div> <div class=\"obc-tmpl-valkyrie__skill-item-desc-gif\" style=\"padding: 0px;\"><img src=\"https://uploadstatic.mihoyo.com/bh3-wiki/2021/12/12/50494840/424f3da584cc9c9424b23a1d3d23502f_237394827728215174.gif\" alt=\"\"></div></div></div></div> <!----></div></div></div></div></div> <div data-v-f0365338=\"\" class=\"detail__body-endpart\"><hr data-v-f0365338=\"\"> <p data-v-f0365338=\"\" class=\"detail__copyright\"><img data-v-f0365338=\"\" src=\"data:image/png;base64,\">\n        词条内容由圣芙蕾雅档案馆编辑团队原创，禁止转载\n      </p></div> <!---->",
