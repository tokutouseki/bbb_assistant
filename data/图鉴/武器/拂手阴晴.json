%B8%BA%E7%81%AB%E4%BC%A4%EF%BC%8C%E4%B8%8D%E5%86%8D%E9%80%82%E5%90%88%E9%9D%9E%E7%81%AB%E4%BC%A4%E5%A5%B3%E6%AD%A6%E7%A5%9E%E8%BE%93%E5%87%BA%E4%BD%BF%E7%94%A8%E3%80%82%3C%2Fp%3E%3Cp%20style%3D%5C%22white-space%3A%20pre-wrap%3B%5C%22%3E%E7%94%B1%E4%BA%8E%E8%AF%A5%E6%AD%A6%E5%99%A8%E7%94%B150%E8%BF%9B%E5%8C%96%E8%87%B365%E7%BA%A7%E6%8F%90%E5%8D%87%E5%B9%85%E5%BA%A6%E8%BE%83%E5%B0%8F%EF%BC%8C%E8%B6%85%E9%99%90%E6%9D%90%E6%96%99%E4%B8%8D%E5%AF%8C%E8%A3%95%E6%97%B6%E4%BB%85%E8%B6%85%E9%99%90%E7%AA%81%E7%A0%B4%E5%8D%B3%E5%8F%AF%E3%80%82%3C%2Fp%3E%22%7D%7D%5D\" data-ts=\"1635677269718\" data-col-type=\"l2r1\" contenteditable=\"false\" draggable=\"true\" data-empty-text=\"\"><div style=\"order: 0;\"> <div data-part=\"role\" data-tmpl=\"weapon\" class=\"obc-tmpl__part obc-tmpl-weapon obc-tmpl__part--role obc-tmpl__part--align-banner\"><h2>适用角色</h2> <table class=\"obc-tmpl__gain-method obc-tmpl-weapon__role-table\"><colgroup><col> <col></colgroup> <tbody><tr><td class=\"h3\"><div class=\"role-icon-td\"><div><img src=\"https://uploadstatic.mihoyo.com/bh3-wiki/2021/09/27/72350798/42a1c5e711171f8acb6f4b0646582847_1438986636829482321.png\" alt=\"\"></div> <span>云墨丹心</span></div></td> <td><div class=\"obc-tmpl-weapon__role-stars\"><span>推荐指数</span> <div><i class=\"obc-tmpl__rate-icon\"></i><i class=\"obc-tmpl__rate-icon\"></i><i class=\"obc-tmpl__rate-icon\"></i><i class=\"obc-tmpl__rate-icon\"></i><i class=\"obc-tmpl__rate-icon\"></i></div></div></td> <td colspan=\"3\" class=\"obc-tmpl__rich-text\"><p style=\"white-space: pre-wrap;\">主动和被动提供不俗的HP，SP回复和火伤加成，离场时可以给队友带来全伤害加成</p></td></tr><tr><td class=\"h3\"><div class=\"role-icon-td\"><div><img src=\"https://uploadstatic.mihoyo.com/bh3-wiki/2021/09/27/72350798/fcd54fef75c29fa33caaaadf573c943e_1363987284832185681.png\" alt=\"\"></div> <span>炽翎</span></div></td> <td><div class=\"obc-tmpl-weapon__role-stars\"><span>推荐指数</span> <div><i class=\"obc-tmpl__rate-icon\"></i><i class=\"obc-tmpl__rate-icon\"></i><i class=\"obc-tmpl__rate-icon\"></i><i class=\"obc-tmpl__rate-icon\"></i><i class=\"obc-tmpl__rate-icon\"></i></div></div></td> <td colspan=\"3\" class=\"obc-tmpl__rich-text\"><p style=\"white-space: pre-wrap;\">主动和被动提供不俗的HP，SP回复和火伤加成，离场时可以给队友带来全伤害加成</p></td></tr><tr><td class=\"h3\"><div class=\"role-icon-td\"><div><img src=\"https://uploadstatic.mihoyo.com/bh3-wiki/2021/10/30/77124895/d173526d7e8c2c2a44046f2d1b4b48ac_3689480806441927436.png\" alt=\"\"></div> <span>识之律者</span></div></td> <td><div class=\"obc-tmpl-weapon__role-stars\"><span>推荐指数</span> <div><i class=\"obc-tmpl__rate-icon\"></i><i class=\"obc-tmpl__rate-icon\"></i><i class=\"obc-tmpl__rate-icon\"></i><i class=\"obc-tmpl__rate-icon\"></i><i class=\"obc-tmpl__rate-icon obc-tmpl__rate-icon--inactive\"></i></div></div></td> <td colspan=\"3\" class=\"obc-tmpl__rich-text\"><p style=\"white-space: pre-wrap;\">提供高额能量回复，与无存之境相比省去了一定的释放分支时间，压缩流程，且亦可为全队提供增伤。部分流程中表现抢眼</p></td></tr><tr><td class=\"h3\"><div class=\"role-icon-td\"><div><img src=\"https://uploadstatic.mihoyo.com/bh3-wiki/2021/10/31/77124895/0fa5604b2bbad2c3c6bb7620ea0a765b_3528693672649702023.png\" alt=\"\"></div> <span>白夜执事</span></div></td> <td><div class=\"obc-tmpl-weapon__role-stars\"><span>推荐指数</span> <div><i class=\"obc-tmpl__rate-icon\"></i><i class=\"obc-tmpl__rate-icon\"></i><i class=\"obc-tmpl__rate-icon\"></i><i class=\"obc-tmpl__rate-icon\"></i><i class=\"obc-tmpl__rate-icon obc-tmpl__rate-icon--inactive\"></i></div></div></td> <td colspan=\"3\" class=\"obc-tmpl__rich-text\"><p style=\"white-space: pre-wrap;\">超限武器提供高额面板，且提供高额能量回复，但没有自身增伤，多出现在需压缩循环的流程中</p></td></tr></tbody></table> <!----></div></div><div style=\"order: 1;\"> <div data-part=\"review\" data-tmpl=\"weapon\" class=\"obc-tmpl__part obc-tmpl-weapon obc-tmpl__part--review obc-tmpl__part--align-banner\"><h2>武器测评</h2> <div class=\"obc-tmpl-valkyrie__skill-container\"><div><img src=\"https://uploadstatic.mihoyo.com/bh3-wiki/2021/09/09/72350798/236991d798a14d5c59d7606663deceb2_2138576681396282594.gif\" class=\"mobile-gif\"></div> <div class=\"obc-tmpl-valkyrie__skill-item\"><div class=\"obc-tmpl-valkyrie__skill-item-desc\"><div class=\"text\"><p style=\"white-space: pre-wrap;\">超限后不再消耗生命值，且新增可回复全队生命与能量的被动，进一步提高能量获取能力。</p><p style=\"white-space: pre-wrap;\">相较于超限前，被动技能略微提高了全队全伤，但自身加伤由全伤变为火伤，不再适合非火伤女武神输出使用。</p><p style=\"white-space: pre-wrap;\">由于该武器由50进化至65级提升幅度较小，超限材料不富裕时仅超限突破即可。</p></div> <div class=\"obc-tmpl-valkyrie__skill-item-desc-gif\" style=\"padding: 0px;\"><img src=\"https://uploadstatic.mihoyo.com/bh3-wiki/2021/09/09/72350798/236991d798a14d5c59d7606663deceb2_2138576681396282594.gif\" alt=\"\"></div></div></div></div> <!----></div></div></div></div></div> <div data-v-f0365338=\"\" class=\"detail__body-endpart\"><hr data-v-f0365338=\"\"> <p data-v-f0365338=\"\" class=\"detail__copyright\"><img data-v-f0365338=\"\" src=\"data:image/png;base64,\">\n        词条内容由圣芙蕾雅档案馆编辑团队原创，禁止转载\n      </p></div> <!---->",
