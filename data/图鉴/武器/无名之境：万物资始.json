Fcontent%2F1140%2Fdetail%22%7D%2C%7B%22name%22%3A%22%E6%B5%81%E4%BD%93%E5%90%88%E9%87%91%E5%9D%97%22%2C%22count%22%3A14%2C%22url%22%3A%22%2Fbh3%2Fwiki%2Fcontent%2F1890%2Fdetail%22%7D%5D%7D%2C%7B%22level%22%3A%2260%22%2C%22material%22%3A%5B%7B%22name%22%3A%22%E7%88%B1%E5%9B%A0%E6%96%AF%E5%9D%A6%E7%8E%AF%E7%A3%81%E6%9C%BA%22%2C%22count%22%3A100%2C%22url%22%3A%22%2Fbh3%2Fwiki%2Fcontent%2F1274%2Fdetail%22%7D%2C%7B%22name%22%3A%22%E8%B6%85%E5%AF%BC%E9%87%91%E5%B1%9E%E6%B0%A2%22%2C%22count%22%3A220%2C%22url%22%3A%22%2Fbh3%2Fwiki%2Fcontent%2F1140%2Fdetail%22%7D%2C%7B%22name%22%3A%22%E6%B5%81%E4%BD%93%E5%90%88%E9%87%91%E5%9D%97%22%2C%22count%22%3A18%2C%22url%22%3A%22%2Fbh3%2Fwiki%2Fcontent%2F1890%2Fdetail%22%7D%5D%7D%5D%7D%7D%5D\" data-ts=\"1674125257925\" data-col-type=\"l2r1\"><div style=\"order: 0;\"> <div data-part=\"info\" data-tmpl=\"weapon\" class=\"obc-tmpl__part obc-tmpl-weapon obc-tmpl__part--info obc-tmpl__part--align-banner\"><h1>武器数据</h1> <table class=\"obc-tmpl__gain-method obc-tmpl-weapon__info-table\"><colgroup><col> <col> <col></colgroup> <tbody><tr><td rowspan=\"3\" class=\"obc-tmpl-weapon__info-avatar\"><img src=\"https://uploadstatic.mihoyo.com/bh3-wiki/2023/01/06/50494840/a63431d7842a1c32d9afb0afd890e40c_3363636315408148666.png\" alt=\"\"></td> <td class=\"h3\">星级</td> <td colspan=\"5\"><div class=\"obc-tmpl-weapon__info-stars\"><i class=\"obc-tmpl__rate-icon\"></i><i class=\"obc-tmpl__rate-icon\"></i><i class=\"obc-tmpl__rate-icon\"></i><i class=\"obc-tmpl__rate-icon\"></i><i class=\"obc-tmpl__rate-icon\"></i><i class=\"obc-tmpl__rate-icon\"></i></div></td></tr> <tr><td class=\"h3\">攻击</td> <td colspan=\"5\" class=\"obc-tmpl__rich-text\">440</td></tr><tr><td class=\"h3\">会心</td> <td colspan=\"5\" class=\"obc-tmpl__rich-text\">20</td></tr></tbody></table> <div class=\"obc-tmpl-weapon__info-desc\"><p style=\"white-space: pre-wrap;\">是谁赋予它名字，令它重焕生机，赠它光与希望，让它得以启辟未来？</p><p style=\"white-space: pre-wrap;\">它静心感受，发现了少女——少女神采奕奕，一如多年前，那行于白雪的自己。</p></div> <!----></div></div><div style=\"order: 1;\"> <div data-part=\"skill\" data-tmpl=\"weapon\" class=\"obc-tmpl__part obc-tmpl-weapon obc-tmpl__part--skill obc-tmpl__part--align-banner\"><h2>武器技能</h2> <table class=\"obc-tmpl__gain-method\"><colgroup><col> <col></colgroup> <tbody><tr><td class=\"h3\">轮回逆断</td> <td colspan=\"5\" class=\"obc-tmpl__rich-text\"><p style=\"white-space: pre-wrap;\">[能量消耗:0][冷却:12秒]向前方敌人发射强力一击，造成700.0%攻击力的火焰元素伤害。终焉之律者释放武器主动技时，可获得3点【降临】计数，且武器主动技在【时燧姿态】和【月锋姿态】下不同，【月锋姿态】下，向前方抛出回旋剑刃，然后将其踢出贯穿前方敌人，造成100%+4*25%+650.0%攻击力的火焰元素伤害，【时燧姿态】下，向前方敌人发射多次攻击，造成5%+7*120.0%攻击力的火焰元素伤害。</p><p style=\"white-space: pre-wrap;\">武器主动技能命中敌人可令敌人进入【衰止】状态，【衰止】状态下每秒受到55.0%攻击力火焰元素伤害，持续6秒，重复获得刷新持续时间</p></td></tr><tr><td class=\"h3\">终始回极</td> <td colspan=\"5\" class=\"obc-tmpl__rich-text\"><p style=\"white-space: pre-wrap;\">自身对【衰止】目标造成全伤害提高30.0%，终焉之律者装备时，分支攻击造成火焰元素伤害提高40.0%，且使用分支攻击切换【时燧姿态】和【月锋姿态】时可重置武器主动技能冷却时间，使用【终末姿态】可降低武器主动技能40.0%的技能冷却时间</p></td></tr><tr><td class=\"h3\">神理无名</td> <td colspan=\"5\" class=\"obc-tmpl__rich-text\"><p style=\"white-space: pre-wrap;\">火焰元素伤害提高45.0%，终焉之律者装备时，绝对时空断裂期间，【衰止】状态下的敌人受到全伤害提高15.0%</p></td></tr></tbody></table> <!----></div></div><div style=\"order: 2;\"> <div data-part=\"forging\" data-tmpl=\"weapon\" class=\"obc-tmpl__part obc-tmpl-weapon obc-tmpl__part--forging obc-tmpl__part--align-banner\"><h2>悬赏锻造</h2> <table class=\"obc-tmpl__gain-method\"><colgroup><col> <col></colgroup> <tbody><tr><td class=\"h3\">超限素材</td> <td colspan=\"5\"><div class=\"forging-material-td\"><div class=\"obc-tmpl__icon-text-num\"><a target=\"_blank\" href=\"/bh3/wiki/content/2090/detail?bbs_presentation_style=no_header\"><img src=\"https://uploadstatic.mihoyo.com/bh3-wiki/2023/01/13/50494840/f6ce7758d75ab72268830f04348763c7_1311742374487275857.png\" alt=\"\" class=\"obc-tmpl__icon\"><span class=\"obc-tmpl__icon-text\">解锁「无名之钥」图鉴后任意双枪蛋池武器</span></a> <span class=\"obc-tmpl__icon-num\">*1</span></div></div></td></tr> <tr><td class=\"h3\">其他素材</td> <td colspan=\"5\"><div 