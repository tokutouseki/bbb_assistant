_5032132306529484562.png%22%7D%5D%2C%22otherMaterial%22%3A%5B%7B%22name%22%3A%22%E7%88%B1%E5%9B%A0%E6%96%AF%E5%9D%A6%E7%8E%AF%E7%A3%81%E6%9C%BA%20%20%22%2C%22num%22%3A100%2C%22url%22%3A%22%2Fbh3%2Fwiki%2Fcontent%2F1274%2Fdetail%22%7D%2C%7B%22name%22%3A%22%E8%B6%85%E5%AF%BC%E9%87%91%E5%B1%9E%E6%B0%A2%22%2C%22num%22%3A50%2C%22url%22%3A%22%2Fbh3%2Fwiki%2Fcontent%2F1140%2Fdetail%22%7D%2C%7B%22name%22%3A%22%E6%B5%81%E4%BD%93%E5%90%88%E9%87%91%E5%9D%97%22%2C%22num%22%3A4%2C%22url%22%3A%22%2Fbh3%2Fwiki%2Fcontent%2F1890%2Fdetail%22%7D%5D%7D%7D%5D\" data-ts=\"1668332746582\" data-col-type=\"l2r1\"><div style=\"order: 0;\"> <div data-part=\"info\" data-tmpl=\"weapon\" class=\"obc-tmpl__part obc-tmpl-weapon obc-tmpl__part--info obc-tmpl__part--align-banner\"><h1>武器数据</h1> <table class=\"obc-tmpl__gain-method obc-tmpl-weapon__info-table\"><colgroup><col> <col> <col></colgroup> <tbody><tr><td rowspan=\"3\" class=\"obc-tmpl-weapon__info-avatar\"><img src=\"https://uploadstatic.mihoyo.com/bh3-wiki/2021/10/30/6100274/7a1ffb843365ee479c4087a0db318ee0_2787974300943952372.png\" alt=\"\"></td> <td class=\"h3\">星级</td> <td colspan=\"5\"><div class=\"obc-tmpl-weapon__info-stars\"><i class=\"obc-tmpl__rate-icon\"></i><i class=\"obc-tmpl__rate-icon\"></i><i class=\"obc-tmpl__rate-icon\"></i><i class=\"obc-tmpl__rate-icon\"></i><i class=\"obc-tmpl__rate-icon\"></i><i class=\"obc-tmpl__rate-icon\"></i></div></td></tr> <tr><td class=\"h3\">攻击</td> <td colspan=\"5\" class=\"obc-tmpl__rich-text\">411</td></tr><tr><td class=\"h3\">会心</td> <td colspan=\"5\" class=\"obc-tmpl__rich-text\">41</td></tr></tbody></table> <div class=\"obc-tmpl-weapon__info-desc\"><p style=\"white-space: pre-wrap;\">“这是我最喜欢的一把弓，静似飞花、动若燕雀，就和这美丽的我一样。可不要盯着看太久哦，不然目光就再也无法从它身上移开了。还是说，你其实是在看我呢？”</p></div> <!----></div></div><div style=\"order: 1;\"> <div data-part=\"skill\" data-tmpl=\"weapon\" class=\"obc-tmpl__part obc-tmpl-weapon obc-tmpl__part--skill obc-tmpl__part--align-banner\"><h2>武器技能</h2> <table class=\"obc-tmpl__gain-method\"><colgroup><col> <col></colgroup> <tbody><tr><td class=\"h3\">水晶之种</td> <td colspan=\"5\" class=\"obc-tmpl__rich-text\"><p style=\"white-space: pre-wrap;\"><span style=\"background-color:rgb(255, 255, 255)\">使用弓箭瞄准并射击敌人(最多瞄准3秒)，对目标造成750%攻击力的物理伤害并在目标处产生一次爆炸，对周围敌人造成100%的物理伤害，并在地上留下持续5秒的水晶结界，结界内的敌人降低70%移动速度。若击中目标弱点，则目标伤害提升至850%，爆炸伤害额外附加50%攻击力物理伤害，并禁锢爆炸范围内的敌人持续1秒。粉色妖精小姐♪使用时，额外获得以下效果：若目标带有【水晶花种】，爆炸将会把【水晶花种】传播到周围敌人身上，武器主动技能的冷却时间和充能时间由装备角色的射击类型决定。</span></p></td></tr><tr><td class=\"h3\">优爱颂诗</td> <td colspan=\"5\" class=\"obc-tmpl__rich-text\"><p style=\"white-space: pre-wrap;\"><span style=\"background-color:rgb(255, 255, 255)\">使用武器主动或蓄力攻击后，暴击伤害提高30%，持续3秒，重复触发刷新持续时间，蓄力攻击造成的物理伤害提高20%</span></p></td></tr><tr><td class=\"h3\">倾心晶刺\t</td> <td colspan=\"5\" class=\"obc-tmpl__rich-text\"><p style=\"white-space: pre-wrap;\"><span style=\"background-color:rgb(255, 255, 255)\">角色全伤害提高15%，水晶结界生成1秒后会生成大量尖刺对范围内的敌人造成300%的物理伤害</span></p></td></tr></tbody></table> <!----></div></div><div style=\"order: 2;\"> <div data-part=\"forging\" data-tmpl=\"weapon\" class=\"obc-tmpl__part obc-tmpl-weapon obc-tmpl__part--forging obc-tmpl__part--align-banner\"><h2>悬赏锻造</h2> <table class=\"obc-tmpl__gain-method\"><colgroup><col> <col></colgroup> <tbody><tr><td class=\"h3\">超限素材</td> <td colspan=\"5\"><div class=\"forging-material-td\"><div class=\"obc-tmpl__icon-text-num\"><a target=\"_blank\" href=\"/bh3/wiki/content/976/detail\"><img src=\"https://uploadstatic.mihoyo.com/bh3-wiki/2021/10/30/6100274/88e739ff2d0d0f41748bf06fe0c9b099_5032132306529484562.png\" alt=\"\" class=\"obc-tmpl__icon\"><span class=\"obc-tmpl__icon-text\">解锁「往世的飞花」图鉴后任意弓箭蛋池武器</span></a> <span class=\"obc-tmpl__icon-num\">*1</span></div></div></td></tr> <tr><td class=\"h3\">其他素材</td> <td colspan=\"5\"><div class=\"forging-other-material-td\"><div class=\"obc-tmpl__icon-text-num\"><a target=\"_blank\" href=\"/bh3/wiki/content/1274/detail\"><!----><span class=\"obc-tmpl__icon-text\">爱因斯坦环磁机  </span></a> <span class=\"obc-tmpl__icon-num\">*100</span></div><div class=\"obc-tmpl__icon-text-num\"><a target=\"_blank\" href=\"/bh3/wiki/content/1140/detail\"><!----><span class=\"obc-tmpl__icon-text\">超导金属氢</span></a> <span class=\"obc-tmpl__icon-num\">*50</span></div><div class=\"obc-tmpl__icon-text-num\"><a target=\"_blank\" href=\"/bh3/wiki/content/1890/detail\"><!----><span class=\"obc-tmpl__icon-text\">流体合金块</span></a> <span class=\"obc-tmpl__icon-num\">*4</span></div></div></td></tr></tbody></table> <!----></div></div></div><div class=\"obc-tmpl obc-tmpl--col-l2r1\" data-data=\"%5B%7B%22tmplKey%22%3A%22stigmata%22%2C%22partKey%22%3A%22material%22%2C%22data%22%3A%7B%22layout_%22%3A%22banner%22%2C%22list%22%3A%5B%7B%22level%22%3A%2250%22%2C%22material%22%3A%5B%7B%22name%22%3A%22%E7%88%B1%E5%9B%A0%E6%96%AF%E5%9D%A6%E7%8E%AF%E7%A3%81%E6%9C%BA%22%2C%22count%22%3A100%2C%22url%22%3A%22%2Fbh3%2Fwiki%2Fcontent%2F1274%2Fdetail%22%7D%2C%7B%22name%22%3A%22%E8%B6%85%E5%AF%BC%E9%87%91%E5%B1%9E%E6%B0%A2%22%2C%22count%22%3A100%2C%22url%22%3A%22%2Fbh3%2Fwiki%2Fcontent%2F1140%2Fdetail%22%7D%2C%7B%22name%22%3A%22%E6%B5%81%E4%BD%93%E5%90%88%E9%87%91%E5%9D%97%22%2C%22count%22%3A9%2C%22url%22%3A%22%2Fbh3%2Fwiki%2Fcontent%2F1890%2Fdetail%22%7D%5D%7D%2C%7B%22level%22%3A%2255%22%2C%22material%22%3A%5B%7B%22name%22%3A%22%E7%88%B1%E5%9B%A0%E6%96%AF%E5%9D%A6%E7%8E%AF%E7%A3%81%E6%9C%BA%22%2C%22count%22%3A100%2C%22url%22%3A%22%2Fbh3%2Fwiki%2Fcontent%2F1274%2Fdetail%22%7D%2C%7B%22name%22%3A%22%E8%B6%85%E5%AF%BC%E9%87%91%E5%B1%9E%E6%B0%A2%22%2C%22count%22%3A150%2C%22url%22%3A%22%2Fbh3%2Fwiki%2Fcontent%2F1140%2Fdetail%22%7D%2C%7B%22name%22%3A%22%E6%B5%81%E4%BD%93%E5%90%88%E9%87%91%E5%9D%97%22%2C%22count%22%3A14%2C%22url%22%3A%22%2Fbh3%2Fwiki%2Fcontent%2F1890%2Fdetail%22%7D%5D%7D%2C%7B%22level%22%3A%2260%22%2C%22material%22%3A%5B%7B%22name%22%3A%22%E7%88%B1%E5%9B%A0%E6%96%AF%E5%9D%A6%E7%8E%AF%E7%A3%81%E6%9C%BA%22%2C%22count%22%3A100%2C%22url%22%3A%22%2Fbh3%2Fwiki%2Fcontent%2F1274%2Fdetail%22%7D%2C%7B%22name%22%3A%22%