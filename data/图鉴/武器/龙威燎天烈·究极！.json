22%2C%22title%22%3A%22%E5%90%8C%E8%B0%83%E7%B4%A0%E6%9D%90%22%2C%22gainMethod%22%3A%5B%7B%22key%22%3A%22%E6%AD%A6%E5%99%A8%22%2C%22value%22%3A%22%3Cp%20style%3D%5C%22white-space%3A%20pre-wrap%3B%5C%22%3E%3Ca%20href%3D%5C%22%2Fbh3%2Fwiki%2Fcontent%2F4023%2Fdetail%3Fbbs_presentation_style%3Dno_header%5C%22%20data-type%3D%5C%22obc-content%5C%22%20target%3D%5C%22_blank%5C%22%3E%E9%BE%99%E5%A8%81%E7%87%8E%E5%A4%A9%E7%83%88%C2%B7%E7%A9%B6%E6%9E%81%EF%BC%81%3C%2Fa%3E%3C%2Fp%3E%3Cp%20style%3D%5C%22white-space%3A%20pre-wrap%3B%5C%22%3E%3Ca%20href%3D%5C%22%2Fbh3%2Fwiki%2Fcontent%2F4022%2Fdetail%3Fbbs_presentation_style%3Dno_header%5C%22%20data-type%3D%5C%22obc-content%5C%22%20target%3D%5C%22_blank%5C%22%3E%E9%BE%99%E5%A8%81%E7%87%8E%E5%A4%A9%E7%83%88%3C%2Fa%3E%3C%2Fp%3E%22%7D%5D%7D%7D%5D\" data-ts=\"1758771826345\" data-col-type=\"l2r1\"><div style=\"order: 0;\"> <div data-part=\"skill\" data-tmpl=\"weapon\" class=\"obc-tmpl__part obc-tmpl-weapon obc-tmpl__part--skill obc-tmpl__part--align-banner\"><h2>武器技能</h2> <table class=\"obc-tmpl__gain-method\"><colgroup><col> <col></colgroup> <tbody><tr><td class=\"h3\">百分百胜率</td> <td colspan=\"5\" class=\"obc-tmpl__rich-text\"><p style=\"white-space: pre-wrap;\"><strong><span style=\"color:rgba(250,140,22,1)\">同调(I&nbsp;/II&nbsp;/III)阶</span></strong></p><p style=\"white-space: pre-wrap;\">敌人受到来自场上角色造成的全伤害提高<strong>（<span style=\"color:rgba(24,144,255,1)\">2.0%/4.0%/6.0%</span>）</strong>（该效果为独立加成）（唯一生效）。逆命魔龙·降临！装备时，敌人受到来自自身的火焰元素伤害提高<strong>（<span style=\"color:rgba(24,144,255,1)\">2.0%/4.0%/6.0%</span>）</strong>（该效果为独立加成）</p></td></tr><tr><td class=\"h3\">寰宇有终，命理不朽</td> <td colspan=\"5\" class=\"obc-tmpl__rich-text\"><p style=\"white-space: pre-wrap;\"><strong><span style=\"color:rgba(250,140,22,1)\">[能量消耗:0][冷却:0秒]</span></strong>武器主动技能的冷却时间、充能次数、技能效果由装备角色的类型决定，若装备佩戴者具有<strong><span style=\"color:rgba(19,194,194,1)\"><u>万有之星</u></span></strong><span data-type=\"详情\" data-name=\"&lt;p style=&quot;white-space: pre-wrap;&quot;&gt;机制：来自星之环分野·【无存之仪】的加护，获得此加护的角色能为队友提供通用强化&lt;/p&gt;\" class=\"wiki-note-text\"><sup class=\"wiki-sup\">[详情]</sup></span>特性，则造成的火焰元素伤害提高<strong><span style=\"color:rgba(24,144,255,1)\">30.0%</span></strong></p><p style=\"white-space: pre-wrap;\">逆命魔龙·降临！装备时</p><p style=\"white-space: pre-wrap;\"><span style=\"color:rgba(64,64,64,1)\">●</span>【龙爪盛放】额外附加<strong><span style=\"color:rgba(24,144,255,1)\">300.0%</span></strong>攻击力的火焰元素伤害</p><p style=\"white-space: pre-wrap;\">●自身造成的点燃积蓄值的附加效率提高<strong><span style=\"color:rgba(24,144,255,1)\">25.0%</span></strong></p></td></tr><tr><td class=\"h3\">召命流天，碎日逐星</td> <td colspan=\"5\" class=\"obc-tmpl__rich-text\"><p style=\"white-space: pre-wrap;\">自身造成的点燃伤害提高<strong><span style=\"color:rgba(24,144,255,1)\">20.0%</span></strong>。逆命魔龙·降临！装备时：星之环激活时：场上敌人受到的全伤害提高<strong><span style=\"color:rgba(24,144,255,1)\">15.0%</span></strong>，全队角色造成的全伤害提高<strong><span style=\"color:rgba(24,144,255,1)\">15.0%</span></strong></p></td></tr><tr><td class=\"h3\">熇宇皆烬，龙息燎原</td> <td colspan=\"5\" class=\"obc-tmpl__rich-text\"><p style=\"white-space: pre-wrap;\">敌人受到来自自身的全伤害提高<strong><span style=\"color:rgba(24,144,255,1)\">15.0%</span></strong>。逆命魔龙·降临！装备时：星之环激活时，敌人受到来自自身的火焰元素伤害提高<strong><span style=\"color:rgba(24,144,255,1)\">12.0%</span></strong></p></td></tr></tbody></table> <!----></div></div><div style=\"order: 1;\"> <div data-part=\"forging\" data-tmpl=\"weapon\" class=\"obc-tmpl__part obc-tmpl-weapon obc-tmpl__part--forging obc-tmpl__part--align-banner\"><h2>悬赏锻造</h2> <table class=\"obc-tmpl__gain-method\"><colgroup><col> <col></colgroup> <tbody><tr><td class=\"h3\">超限素材</td> <td colspan=\"5\"><div class=\"forging-material-td\"><div class=\"obc-tmpl__icon-text-num\"><a target=\"_blank\" href=\"/bh3/wiki/content/4022/detail?bbs_presentation_style=no_header\"><img src=\"https://act-upload.mihoyo.com/bh3-wiki/2025/07/07/50494840/616fbfead7ede27a791d66351a6e6b4f_2451798137205623034.png\" alt=\"\" class=\"obc-tmpl__icon\"><span class=\"obc-tmpl__icon-text\">获得「龙威燎天烈」后解锁锻造</span></a> <span class=\"obc-tmpl__icon-num\">*1</span></div></div></td></tr> <tr><td class=\"h3\">其他素材</td> <td colspan=\"5\"><div class=\"forging-other-material-td\"><div class=\"obc-tmpl__icon-text-num\"><a target=\"_blank\" href=\"/bh3/wiki/content/1274/detail?bbs_presentation_style=no_header\"><!----><span class=\"obc-tmpl__icon-text\">爱因斯坦环磁机</span></a> <span class=\"obc-tmpl__icon-num\">*100</span></div><div class=\"obc-tmpl__icon-text-num\"><a target=\"_blank\" href=\"/bh3/wiki/content/1140/detail?bbs_presentation_style=no_header\"><!----><span class=\"obc-tmpl__icon-text\">超导金属氢</span></a> <span class=\"obc-tmpl__icon-num\">*50</span></div><div class=\"obc-tmpl__icon-text-num\"><a target=\"_blank\" href=\"/bh3/wiki/content/1890/detail?bbs_presentation_style=no_header\"><!----><span class=\"obc-tmpl__icon-text\">流体合金块</span></a> <span class=\"obc-tmpl__icon-num\">*4</span></div></div></td></tr></tbody></table> <!----></div></div><div style=\"order: 2;\"> <div data-part=\"material\" data-tmpl=\"stigmata\" class=\"obc-tmpl__part obc-tmpl-stigmata obc-tmpl__part--material obc-tmpl__part--align-banner\"><h2>进化材料</h2> <table class=\"obc-tmpl__gain-method\"><colgroup><col> <col></colgroup> <thead><tr><th>突破等级</th> <th colspan=\"5\">所需材料</th></tr></thead> <tbody><tr><td class=\"h3\">50</td> <td colspan=\"5\"><div class=\"material-td\"><div class=\"obc-tmpl__icon-text-num\"><a target=\"_blank\" href=\"/bh3/wiki/content/1274/detail?bbs_presentation_style=no_header\"><!----><span class=\"obc-tmpl__icon-text\">爱因斯坦环磁机</span></a> <span class=\"obc-tmpl__icon-num\">*100</span></div><div class=\"obc-tmpl__icon-text-num\"><a target=\"_blank\" href=\"/bh3/wiki/content/1140/detail?bbs_presentation_style=no_header\"><!----><span class=\"obc-tmpl__icon-text\">超导金属氢</span></a> <span class=\"obc-tmpl__icon-num\">*100</span></div><div class=\"obc-tmpl__icon-text-num\"><a target=\"_blank\" href=\"/bh3/wiki/content/1890/detail?bbs_presentation_style=no_header\">