3D%5C%22white-space%3A%20pre-wrap%3B%5C%22%3E%E9%80%9A%E8%BF%87%3Ca%20href%3D%5C%22https%3A%2F%2Fbaike.mihoyo.com%2Fbh3%2Fwiki%2Fcontent%2F1180%2Fdetail%5C%22%20data-type%3D%5C%22obc-content%5C%22%20target%3D%5C%22_blank%5C%22%3E%E5%A4%A7%E4%BC%9F%E5%93%A5%E9%BB%91%E9%87%91%E5%8D%A1%3C%2Fa%3E%E5%85%91%E6%8D%A2%E8%8E%B7%E5%BE%97%3C%2Fp%3E%22%7D%2C%7B%22key%22%3A%22%E6%9D%90%E6%96%99-%E6%B6%88%E8%80%97%E5%93%81%22%2C%22value%22%3A%22%3Cp%20style%3D%5C%22white-space%3A%20pre-wrap%3B%5C%22%3E%E5%BC%80%E5%90%AF%3Ca%20href%3D%5C%22%2Fbh3%2Fwiki%2Fcontent%2F3513%2Fdetail%3Fbbs_presentation_style%3Dno_header%5C%22%20data-type%3D%5C%22obc-content%5C%22%20target%3D%5C%22_blank%5C%22%3E%E7%A5%9E%E4%B9%8B%E9%94%AE%E8%87%AA%E9%80%89%E7%AE%B1%3C%2Fa%3E%E5%85%91%E6%8D%A2%E8%8E%B7%E5%BE%97%3C%2Fp%3E%22%7D%5D%7D%7D%5D\" data-ts=\"1766928613202\" data-col-type=\"l2r1\"><div style=\"order: 0;\"> <div data-part=\"info\" data-tmpl=\"weapon\" class=\"obc-tmpl__part obc-tmpl-weapon obc-tmpl__part--info obc-tmpl__part--align-banner\"><h1>武器数据</h1> <table class=\"obc-tmpl__gain-method obc-tmpl-weapon__info-table\"><colgroup><col> <col> <col></colgroup> <tbody><tr><td rowspan=\"3\" class=\"obc-tmpl-weapon__info-avatar\"><img src=\"https://uploadstatic.mihoyo.com/bh3-wiki/2021/09/10/75940953/ae23ecded4d99a47913e2a07cc43df66_775330911391544958.png\" alt=\"\"></td> <td class=\"h3\">星级</td> <td colspan=\"5\"><div class=\"obc-tmpl-weapon__info-stars\"><i class=\"obc-tmpl__rate-icon\"></i><i class=\"obc-tmpl__rate-icon\"></i><i class=\"obc-tmpl__rate-icon\"></i><i class=\"obc-tmpl__rate-icon\"></i><i class=\"obc-tmpl__rate-icon\"></i></div></td></tr> <tr><td class=\"h3\">攻击</td> <td colspan=\"5\" class=\"obc-tmpl__rich-text\">286</td></tr><tr><td class=\"h3\">会心</td> <td colspan=\"5\" class=\"obc-tmpl__rich-text\">21</td></tr></tbody></table> <div class=\"obc-tmpl-weapon__info-desc\"><p style=\"white-space: pre-wrap;\">由旧文明第九律者的核心制成的神之键，拥有操纵重力的能力。其核心组件是一个直径约10厘米的球体，可通过替换其他结构的外置稳定器来适应不同的作战需要。手枪形态的神之键在一定程度上压缩了输出功率，以此将武器的定向攻击能力大大提升，即便是战士以外的人也能充分发挥它的力量。</p></div> <!----></div></div><div style=\"order: 1;\"> <div data-part=\"skill\" data-tmpl=\"weapon\" class=\"obc-tmpl__part obc-tmpl-weapon obc-tmpl__part--skill obc-tmpl__part--align-banner\"><h2>武器技能</h2> <table class=\"obc-tmpl__gain-method\"><colgroup><col> <col></colgroup> <tbody><tr><td class=\"h3\">禁果</td> <td colspan=\"5\" class=\"obc-tmpl__rich-text\"><p style=\"white-space: pre-wrap;\">[能量消耗:6][冷却:18秒]向目标发射一枚持续7秒的重力炸弹，造成600%攻击力的物理伤害，该攻击对护盾造成的伤害提高150%。在重力炸弹持续期间内，若目标敌人的护盾被破坏则会对其施加【重力锁】，使敌人无法行动并且冻结护盾回复时间，持续3秒。3秒后重力炸弹爆炸对周围敌人造成500%攻击力的范围物理伤害。重力锁生成时以及重力炸弹爆炸时都会使全队角色物理伤害提高12.0%，持续9秒（ 不可叠加，刷新持续时间 ）。</p><p style=\"white-space: pre-wrap;\">若重力炸弹命中没有护盾或破盾状态的敌人则会直接爆炸</p></td></tr><tr><td class=\"h3\">原罪</td> <td colspan=\"5\" class=\"obc-tmpl__rich-text\"><p style=\"white-space: pre-wrap;\">重力锁生成时以及重力炸弹爆炸时都会对范围敌人施加脆弱效果，防御力降低65%,持续9秒（ 不可叠加刷新持续时间 ）</p></td></tr><tr><td class=\"h3\">吞噬之键</td> <td colspan=\"5\" class=\"obc-tmpl__rich-text\"><p style=\"white-space: pre-wrap;\">在联机Raid关卡中，角色暴击伤害提高40.0%，暴击率提高5.0%</p></td></tr></tbody></table> <!----></div></div><div style=\"order: 2;\"> <div data-part=\"gainMethod\" data-tmpl=\"general\" class=\"obc-tmpl__part obc-tmpl-general obc-tmpl__part--gainMethod obc-tmpl__part--align-banner\"><h2>获取方式</h2> <table class=\"obc-tmpl__gain-method\"><colgroup><col> <col></colgroup> <tbody><tr><td class=\"h3\">装备补给</td> <td colspan=\"5\" class=\"obc-tmpl__rich-text\"><p style=\"white-space: pre-wrap;\">活动补给</p></td></tr><tr><td class=\"h3\">大伟哥别墅</td> <td colspan=\"5\" class=\"obc-tmpl__rich-text\"><p style=\"white-space: pre-wrap;\">通过<a href=\"https://baike.mihoyo.com/bh3/wiki/content/1180/detail\" data-type=\"obc-content\" target=\"_blank\">大伟哥黑金卡</a>兑换获得</p></td></tr><tr><td class=\"h3\">材料-消耗品</td> <td colspan=\"5\" class=\"obc-tmpl__rich-text\"><p style=\"white-space: pre-wrap;\">开启<a href=\"/bh3/wiki/content/3513/detail?bbs_presentation_style=no_header\" data-type=\"obc-content\" target=\"_blank\">神之键自选箱</a>兑换获得</p></td></tr></tbody></table> <!----></div></div></div><div class=\"obc-tmpl obc-tmpl--col-l2r1\" data-data=\"%5B%7B%22tmplKey%22%3A%22stigmata%22%2C%22partKey%22%3A%22material%22%2C%22data%22%3A%7B%22layout_%22%3A%22banner%22%2C%22list%22%3A%5B%7B%22level%22%3A%2235%22%2C%22material%22%3A%5B%7B%22name%22%3A%22%E4%B8%89%E5%88%86%E7%BB%93%E6%99%B6%22%2C%22count%22%3A3%2C%22url%22%3A%22%2Fbh3%2Fwiki%2Fcontent%2F1132%2Fdetail%22%7D%2C%7B%22name%22%3A%22%E6%B5%81%E4%BD%93%E5%90%88%E9%87%91%E5%9D%97%22%2C%22count%22%3A1%2C%22url%22%3A%22%2Fbh3%2Fwiki%2Fcontent%2F1890%2Fdetail%22%7D%2C%7B%22name%22%3A%22%E7%9B%B8%E8%BD%AC%E7%A7%BB%E9%95%9C%E9%9D%A2%22%2C%22count%22%3A3%2C%22url%22%3A%22%2Fbh3%2Fwiki%2Fcontent%2F1273%2Fdetail%22%7D%5D%7D%2C%7B%22level%22%3A%2240%22%2C%22material%22%3A%5B%7B%22name%22%3A%22%E4%B8%89%E5%88%86%E7%BB%93%E6%99%B6%22%2C%22count%22%3A3%2C%22url%22%3A%22%2Fbh3%2Fwiki%2Fcontent%2F1132%2Fdetail%22%7D%2C%7B%22name%22%3A%22%E6%B5%81%E4%BD%93%E5%90%88%E9%87%91%E5%9D%97%22%2C%22count%22%3A2%2C%22url%22%3A%22%2Fbh3%2Fwiki%2Fcontent%2F1890%2Fdetail%22%7D%2C%7B%22name%22%3A%22%E7%9B%B8%E8%BD%AC%E7%A7%BB%E9%95%9C%E9%9D%A2%22%2C%22count%22%3A8%2C%22url%22%3A%22%2Fbh3%2Fwiki%2Fcontent%2F1273%2Fdetail%22%7D%5D%7D%2C%7B%22level%22%3A%2245%22%2C%22material%22%3A%5B%7B%22name%22%3A%22%E4%B8%89%E5%88%86%E7%BB%93%E6%99%B6%22%2C%22count%22%3A3%2C%22url%22%3A%22%2Fbh3%2Fwiki%2Fcontent%2F1132%2Fdetail%22%7D%2C%7B%22name%22%3A%22%E6%B5%81%E4%BD%93%E5%90%88%E9%87%91%E5%9D%97%22%2C%22count%22%3A3%2C%22url%22%3A%22%2Fbh3%2Fwiki%2Fcontent%2F1890%2Fdetail%22%7D%2C%7B%22name%22%3A%22%E7%9B%B8%E8%BD%AC%E7%A7%BB%E9%95%9C%E9%9D%A2%22%2C%22count%22%3A12%2C%22url%22%3A%22%2Fbh3%2Fwiki%2Fcontent%2F1273%2Fdetail%22%7D%5D%7D%5D%7D%7D%5D\" data-ts=\"1667210976394\" data-col-type=\"l2r1\"><div style=\"order: 0;\"> <div data-part=\"material\" data-tmpl=\"stigmata\" class=\"obc-tmpl__part obc-tmpl-stigmata obc-tmpl__part--material obc-tmpl__part--align-b