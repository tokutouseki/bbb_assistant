able=\"false\" draggable=\"true\" data-empty-text=\"\"><div style=\"order: 0;\"> <div data-part=\"role\" data-tmpl=\"weapon\" class=\"obc-tmpl__part obc-tmpl-weapon obc-tmpl__part--role obc-tmpl__part--align-banner\"><h2>适用角色</h2> <table class=\"obc-tmpl__gain-method obc-tmpl-weapon__role-table\"><colgroup><col> <col></colgroup> <tbody><tr><td class=\"h3\"><div class=\"role-icon-td\"><div><img src=\"https://uploadstatic.mihoyo.com/bh3-wiki/2021/09/27/72350798/c59344b134dabdbbc4819aa70ceb5735_7435827171926639702.png\" alt=\"\"></div> <span>第六夜想曲</span></div></td> <td><div class=\"obc-tmpl-weapon__role-stars\"><span>推荐指数</span> <div><i class=\"obc-tmpl__rate-icon\"></i><i class=\"obc-tmpl__rate-icon\"></i><i class=\"obc-tmpl__rate-icon\"></i><i class=\"obc-tmpl__rate-icon\"></i><i class=\"obc-tmpl__rate-icon\"></i></div></div></td> <td colspan=\"3\" class=\"obc-tmpl__rich-text\"><p style=\"white-space: pre-wrap;\">聚怪提高对群输出，提高抗打断</p></td></tr><tr><td class=\"h3\"><div class=\"role-icon-td\"><div><img src=\"https://uploadstatic.mihoyo.com/bh3-wiki/2021/09/27/72350798/9c093a782633ab34e097953cb5d7b3a3_874170243551066733.png\" alt=\"\"></div> <span>空之律者</span></div></td> <td><div class=\"obc-tmpl-weapon__role-stars\"><span>推荐指数</span> <div><i class=\"obc-tmpl__rate-icon\"></i><i class=\"obc-tmpl__rate-icon\"></i><i class=\"obc-tmpl__rate-icon\"></i><i class=\"obc-tmpl__rate-icon obc-tmpl__rate-icon--inactive\"></i><i class=\"obc-tmpl__rate-icon obc-tmpl__rate-icon--inactive\"></i></div></div></td> <td colspan=\"3\" class=\"obc-tmpl__rich-text\"><p style=\"white-space: pre-wrap;\">高面板及释放必杀技后的全伤提高可作下为替代武器</p></td></tr></tbody></table> <!----></div></div><div style=\"order: 1;\"> <div data-part=\"review\" data-tmpl=\"weapon\" class=\"obc-tmpl__part obc-tmpl-weapon obc-tmpl__part--review obc-tmpl__part--align-banner\"><h2>武器测评</h2> <div class=\"obc-tmpl-valkyrie__skill-container\"><div><img src=\"https://uploadstatic.mihoyo.com/bh3-wiki/2021/09/09/72350798/d089f8ae89f301cd2d4c48897e74cb3e_8763435262801556301.gif\" class=\"mobile-gif\"></div> <div class=\"obc-tmpl-valkyrie__skill-item\"><div class=\"obc-tmpl-valkyrie__skill-item-desc\"><div class=\"text\"><p style=\"white-space: pre-wrap;\">相较超限前增加了高额冰冻元素加伤，主动技能聚怪造成冰冻伤害并回复夜眼值，令第六夜想曲的对群循环输出能力更上一层楼。而使用分支和主动会提高抗打断力也减少第六夜想曲普攻时容易被打断的劣势。但相较超限前缺少了角色出场后的全伤加成，对其他没有冰冻伤害的双枪角色的价值反而降低，仅剩QTE、武器主动和必杀技的全伤加成作为没有选择时的选择。</p></div> <div class=\"obc-tmpl-valkyrie__skill-item-desc-gif\" style=\"padding: 0px;\"><img src=\"https://uploadstatic.mihoyo.com/bh3-wiki/2021/09/09/72350798/d089f8ae89f301cd2d4c48897e74cb3e_8763435262801556301.gif\" alt=\"\"></div></div></div></div> <!----></div></div></div></div></div> <div data-v-f0365338=\"\" class=\"detail__body-endpart\"><hr data-v-f0365338=\"\"> <p data-v-f0365338=\"\" class=\"detail__copyright\"><img data-v-f0365338=\"\" src=\"data:image/png;base64,\">\n        词条内容由圣芙蕾雅档案馆编辑团队原创，禁止转载\n      </p></div> <!---->",
