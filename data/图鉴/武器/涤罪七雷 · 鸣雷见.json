C%EF%BC%8C%E5%A4%A7%E5%B9%85%E6%8F%90%E9%AB%98%E9%9B%B7%E4%B9%8B%E5%BE%8B%E8%80%85%E5%AF%B9%E5%90%84%E7%B1%BB%E5%8A%A0%E6%88%90%E7%9A%84%E5%88%A9%E7%94%A8%E7%8E%87%EF%BC%8C%E5%A5%91%E5%90%88%E5%85%B6%E8%BE%93%E5%87%BA%E6%A8%A1%E5%BC%8F%E7%9A%84%E5%90%8C%E6%97%B6%E6%8F%90%E9%AB%98%E4%BA%86%E8%A7%92%E8%89%B2%E7%9A%84%E5%8F%AF%E7%8E%A9%E6%80%A7%EF%BC%8C%E7%BE%8E%E4%B8%AD%E4%B8%8D%E8%B6%B3%E7%9A%84%E5%88%99%E6%98%AF%E6%8F%90%E9%AB%98%E4%BA%86%E5%BF%85%E6%9D%80%E6%8A%80%E7%9A%84%E5%86%B7%E5%8D%B4%E6%97%B6%E9%97%B4%EF%BC%9B%3C%2Fp%3E%3Cp%20style%3D%5C%22white-space%3A%20pre-wrap%3B%5C%22%3E%E4%B8%80%E5%AE%9A%E6%93%8D%E4%BD%9C%E4%B8%8B%E5%8F%AF%E5%B0%86%E9%A3%9E%E9%BE%99%E4%BD%9C%E4%B8%BA%E5%8F%AC%E5%94%A4%E7%89%A9%E9%A9%BB%E5%9C%BA%E5%8D%8F%E6%88%98%EF%BC%8C%E8%A1%A5%E5%85%85%E4%BC%A4%E5%AE%B3%E7%9A%84%E5%90%8C%E6%97%B6%E5%85%B7%E6%9C%89%E4%B8%80%E5%AE%9A%E7%9A%84%E5%8A%9F%E8%83%BD%E6%80%A7%E3%80%82%3C%2Fp%3E%22%7D%7D%5D\" data-ts=\"1655539445145\" data-col-type=\"l2r1\"><div style=\"order: 0;\"> <div data-part=\"role\" data-tmpl=\"weapon\" class=\"obc-tmpl__part obc-tmpl-weapon obc-tmpl__part--role obc-tmpl__part--align-banner\"><h2>适用角色</h2> <table class=\"obc-tmpl__gain-method obc-tmpl-weapon__role-table\"><colgroup><col> <col></colgroup> <tbody><tr><td class=\"h3\"><div class=\"role-icon-td\"><div><img src=\"https://uploadstatic.mihoyo.com/bh3-wiki/2022/06/01/50494840/f87dee8d6f9d00e9c9b3d265e2071321_8523696029578146631.png\" alt=\"\"></div> <span>雷之律者</span></div></td> <td><div class=\"obc-tmpl-weapon__role-stars\"><span>推荐指数</span> <div><i class=\"obc-tmpl__rate-icon\"></i><i class=\"obc-tmpl__rate-icon\"></i><i class=\"obc-tmpl__rate-icon\"></i><i class=\"obc-tmpl__rate-icon\"></i><i class=\"obc-tmpl__rate-icon\"></i></div></div></td> <td colspan=\"3\" class=\"obc-tmpl__rich-text\"><p style=\"white-space: pre-wrap;\">全方面提升输出和循环能力，爆发状态下可使用武器技能并立刻衔接终结技，拓展了角色的玩法和机制。</p></td></tr><tr><td class=\"h3\"><div class=\"role-icon-td\"><div><img src=\"https://uploadstatic.mihoyo.com/bh3-wiki/2022/06/01/50494840/f2842350296342fca85223dae40d0b3a_7621705249634304223.png\" alt=\"\"></div> <span>夜隐重霞</span></div></td> <td><div class=\"obc-tmpl-weapon__role-stars\"><span>推荐指数</span> <div><i class=\"obc-tmpl__rate-icon\"></i><i class=\"obc-tmpl__rate-icon\"></i><i class=\"obc-tmpl__rate-icon\"></i><i class=\"obc-tmpl__rate-icon\"></i><i class=\"obc-tmpl__rate-icon obc-tmpl__rate-icon--inactive\"></i></div></div></td> <td colspan=\"3\" class=\"obc-tmpl__rich-text\"><p style=\"white-space: pre-wrap;\">提高面板和输出能力，武器技能回复能量提升循环能力，开启必杀技后刷新武器技能冷却时间进一步提升输出能力。</p></td></tr><tr><td class=\"h3\"><div class=\"role-icon-td\"><div><img src=\"https://uploadstatic.mihoyo.com/bh3-wiki/2022/06/01/50494840/ecc1e494d2bb0508b66841717df36352_2852800672761243776.png\" alt=\"\"></div> <span>破晓强袭</span></div></td> <td><div class=\"obc-tmpl-weapon__role-stars\"><span>推荐指数</span> <div><i class=\"obc-tmpl__rate-icon\"></i><i class=\"obc-tmpl__rate-icon\"></i><i class=\"obc-tmpl__rate-icon\"></i><i class=\"obc-tmpl__rate-icon obc-tmpl__rate-icon--inactive\"></i><i class=\"obc-tmpl__rate-icon obc-tmpl__rate-icon--inactive\"></i></div></div></td> <td colspan=\"3\" class=\"obc-tmpl__rich-text\"><p style=\"white-space: pre-wrap;\">提高面板和输出能力，武器技能回复能量提升循环能力，开启必杀技后刷新武器技能冷却时间进一步提升输出能力。</p></td></tr></tbody></table> <!----></div></div><div style=\"order: 1;\"> <div data-part=\"review\" data-tmpl=\"weapon\" class=\"obc-tmpl__part obc-tmpl-weapon obc-tmpl__part--review obc-tmpl__part--align-banner\"><h2>武器测评</h2> <div class=\"obc-tmpl-valkyrie__skill-container\"><div><img src=\"https://uploadstatic.mihoyo.com/bh3-wiki/2022/06/18/50494840/66ef42efb2e9924a134467a20c081bb6_9146967680249020190.gif\" class=\"mobile-gif\"></div> <div class=\"obc-tmpl-valkyrie__skill-item\"><div class=\"obc-tmpl-valkyrie__skill-item-desc\"><div class=\"text\"><p style=\"white-space: pre-wrap;\">涤罪七雷 · 鸣的超限形态，大幅提升角色非爆发状态下的雷电元素伤害，以及对克制敌人的全伤害；</p><p style=\"white-space: pre-wrap;\">使用武器主动后可回复能量，释放必杀技后重置武器冷却时间，是一把加成和倍率可观、且功能性较强的通用雷伤武器。</p><p style=\"white-space: pre-wrap;\">雷之律者使用时拥有额外机制。入场时提供额外律者能量，武器技能命中时附加【鸣神】状态，且爆发状态下可释放武器技能并触发极限闪避技能，之后可立即释放终结技；</p><p style=\"white-space: pre-wrap;\">两段必杀技期间均附带时停效果，大幅提高雷之律者对各类加成的利用率，契合其输出模式的同时提高了角色的可玩性，美中不足的则是提高了必杀技的冷却时间；</p><p style=\"white-space: pre-wrap;\">一定操作下可将飞龙作为召唤物驻场协战，补充伤害的同时具有一定的功能性。</p></div> <div class=\"obc-tmpl-valkyrie__skill-item-desc-gif\" style=\"padding: 0px;\"><img src=\"https://uploadstatic.mihoyo.com/bh3-wiki/2022/06/18/50494840/66ef42efb2e9924a134467a20c081bb6_9146967680249020190.gif\" alt=\"\"></div></div></div></div> <!----></div></div></div></div></div> <div data-v-f0365338=\"\" class=\"detail__body-endpart\"><hr data-v-f0365338=\"\"> <p data-v-f0365338=\"\" class=\"detail__copyright\"><img data-v-f0365338=\"\" src=\"data:image/png;base64,\">\n        词条内容由圣芙蕾雅档案馆编辑团队原创，禁止转载\n      </p></div> <!---->",
