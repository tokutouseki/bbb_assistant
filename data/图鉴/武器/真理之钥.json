%2Fcontent%2F1814%2Fdetail%5C%22%20data-type%3D%5C%22obc-content%5C%22%20target%3D%5C%22_blank%5C%22%3E%E6%AD%A6%E5%99%A8%E8%87%AA%E9%80%89%E7%AE%B1%3C%2Fa%3E%E5%85%91%E6%8D%A2%E8%8E%B7%E5%BE%97%3C%2Fp%3E%22%7D%5D%7D%7D%5D\" data-ts=\"1668328979475\" data-col-type=\"l2r1\"><div style=\"order: 0;\"> <div data-part=\"info\" data-tmpl=\"weapon\" class=\"obc-tmpl__part obc-tmpl-weapon obc-tmpl__part--info obc-tmpl__part--align-banner\"><h1>武器数据</h1> <table class=\"obc-tmpl__gain-method obc-tmpl-weapon__info-table\"><colgroup><col> <col> <col></colgroup> <tbody><tr><td rowspan=\"3\" class=\"obc-tmpl-weapon__info-avatar\"><img src=\"https://uploadstatic.mihoyo.com/bh3-wiki/2021/09/07/77124895/75d78f817fe9bb792c7a8136d5856cd8_7784376157397884319.png\" alt=\"\"></td> <td class=\"h3\">星级</td> <td colspan=\"5\"><div class=\"obc-tmpl-weapon__info-stars\"><i class=\"obc-tmpl__rate-icon\"></i><i class=\"obc-tmpl__rate-icon\"></i><i class=\"obc-tmpl__rate-icon\"></i><i class=\"obc-tmpl__rate-icon\"></i><i class=\"obc-tmpl__rate-icon\"></i></div></td></tr> <tr><td class=\"h3\">攻击</td> <td colspan=\"5\" class=\"obc-tmpl__rich-text\">294</td></tr><tr><td class=\"h3\">会心</td> <td colspan=\"5\" class=\"obc-tmpl__rich-text\">18</td></tr></tbody></table> <div class=\"obc-tmpl-weapon__info-desc\"><p style=\"white-space: pre-wrap;\">布洛妮娅使用理之律者的力量构造的火炮，不仅能装载在重装小兔双肩作为主武器使用，亦能独立在空中浮游援护主人。理之律者的构造之力原本需要日积月累的理解，但布洛妮娅能在短时间内构造出完成度如此高的火炮，或许是因为她本就对战场和武器无比熟悉。</p></div> <!----></div></div><div style=\"order: 1;\"> <div data-part=\"skill\" data-tmpl=\"weapon\" class=\"obc-tmpl__part obc-tmpl-weapon obc-tmpl__part--skill obc-tmpl__part--align-banner\"><h2>武器技能</h2> <table class=\"obc-tmpl__gain-method\"><colgroup><col> <col></colgroup> <tbody><tr><td class=\"h3\">万象蓝图</td> <td colspan=\"5\" class=\"obc-tmpl__rich-text\"><p style=\"white-space: pre-wrap;\">蓄力炮，一层：单发炮弹，二层：双发更强炮弹，三层：三发超强炮弹。角色造成的冰冻元素伤害提高35%</p></td></tr><tr><td class=\"h3\">理性造物</td> <td colspan=\"5\" class=\"obc-tmpl__rich-text\"><p style=\"white-space: pre-wrap;\">[能量消耗:5][冷却:25秒]构造武器攻击敌人，造成500.0%+9*85.0%+300%攻击力的冰冻元素伤害，最后一击造成10点冻结积蓄值；使用后，角色造成的全提高45%，持续7秒。理之律者使用时，主动技能会使敌人进入持续7秒的解析状态，使用必杀技时，立即恢复5点能量值</p></td></tr></tbody></table> <!----></div></div><div style=\"order: 2;\"> <div data-part=\"gainMethod\" data-tmpl=\"general\" class=\"obc-tmpl__part obc-tmpl-general obc-tmpl__part--gainMethod obc-tmpl__part--align-banner\"><h2>获取方式</h2> <table class=\"obc-tmpl__gain-method\"><colgroup><col> <col></colgroup> <tbody><tr><td class=\"h3\">补给获取</td> <td colspan=\"5\" class=\"obc-tmpl__rich-text\"><p style=\"white-space: pre-wrap;\">精准补给、活动补给</p></td></tr><tr><td class=\"h3\">大伟哥别墅</td> <td colspan=\"5\" class=\"obc-tmpl__rich-text\"><p style=\"white-space: pre-wrap;\">消耗<a href=\"/bh3/wiki/content/1180/detail\" data-type=\"obc-content\" target=\"_blank\">大伟哥黑金卡</a>兑换获得</p></td></tr><tr><td class=\"h3\">作战凭证</td> <td colspan=\"5\" class=\"obc-tmpl__rich-text\"><p style=\"white-space: pre-wrap;\">第十四期（V4.6）、第二十一期（V5.3）作战工坊限时兑换</p></td></tr><tr><td class=\"h3\">天命商城</td> <td colspan=\"5\" class=\"obc-tmpl__rich-text\"><p style=\"white-space: pre-wrap;\">通过既往天命商城特典卡兑换获得</p></td></tr><tr><td class=\"h3\">日常商店</td> <td colspan=\"5\" class=\"obc-tmpl__rich-text\"><p style=\"white-space: pre-wrap;\">置换空间（概率刷出）</p></td></tr><tr><td class=\"h3\">材料-消耗品</td> <td colspan=\"5\" class=\"obc-tmpl__rich-text\"><p style=\"white-space: pre-wrap;\">开启<a href=\"/bh3/wiki/content/1814/detail\" data-type=\"obc-content\" target=\"_blank\">武器自选箱</a>兑换获得</p></td></tr></tbody></table> <!----></div></div></div><div class=\"obc-tmpl obc-tmpl--col-l2r1\" data-data=\"%5B%7B%22tmplKey%22%3A%22stigmata%22%2C%22partKey%22%3A%22material%22%2C%22data%22%3A%7B%22layout_%22%3A%22banner%22%2C%22list%22%3A%5B%7B%22level%22%3A%2235%22%2C%22material%22%3A%5B%7B%22name%22%3A%22%E4%B8%89%E5%88%86%E7%BB%93%E6%99%B6%22%2C%22count%22%3A3%2C%22url%22%3A%22%2Fbh3%2Fwiki%2Fcontent%2F1132%2Fdetail%22%7D%2C%7B%22name%22%3A%22%E6%B5%81%E4%BD%93%E5%90%88%E9%