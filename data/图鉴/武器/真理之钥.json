E%81%E5%85%B6%E5%A5%91%E5%90%88%E7%90%86%E4%B9%8B%E5%BE%8B%E8%80%85%EF%BC%8C%E8%80%8C%E5%88%AB%E7%9A%84%E8%A7%92%E8%89%B2%E5%88%99%E5%8F%AF%E5%BD%93%E5%81%9A%E4%B8%80%E4%B8%AA%E4%B8%8B%E4%BD%8D%E6%9B%BF%E4%BB%A3%E4%BD%BF%E7%94%A8%E3%80%82%E5%85%B6%E4%B8%AD%E8%BF%B7%E5%9F%8E%E9%AA%87%E5%85%94%E5%9C%A8%E6%88%98%E5%9C%BA%E4%B8%AD%E5%81%B6%E6%9C%89%E6%90%BA%E5%B8%A6%E3%80%82%3C%2Fp%3E%22%7D%7D%5D\" data-ts=\"1632922812923\" data-col-type=\"l2r1\" contenteditable=\"false\" draggable=\"true\" data-empty-text=\"\"><div style=\"order: 0;\"> <div data-part=\"role\" data-tmpl=\"weapon\" class=\"obc-tmpl__part obc-tmpl-weapon obc-tmpl__part--role obc-tmpl__part--align-banner\"><h2>适用角色</h2> <table class=\"obc-tmpl__gain-method obc-tmpl-weapon__role-table\"><colgroup><col> <col></colgroup> <tbody><tr><td class=\"h3\"><div class=\"role-icon-td\"><div><img src=\"https://uploadstatic.mihoyo.com/bh3-wiki/2021/09/18/77124895/0f577990b025b4695221ff233b02a53d_1900455830015162464.png\" alt=\"\"></div> <span>迷城骇兔</span></div></td> <td><div class=\"obc-tmpl-weapon__role-stars\"><span>推荐指数</span> <div><i class=\"obc-tmpl__rate-icon\"></i><i class=\"obc-tmpl__rate-icon\"></i><i class=\"obc-tmpl__rate-icon\"></i><i class=\"obc-tmpl__rate-icon\"></i><i class=\"obc-tmpl__rate-icon obc-tmpl__rate-icon--inactive\"></i></div></div></td> <td colspan=\"3\" class=\"obc-tmpl__rich-text\"><p style=\"white-space: pre-wrap;\">战场特殊流程中使用</p></td></tr><tr><td class=\"h3\"><div class=\"role-icon-td\"><div><img src=\"https://uploadstatic.mihoyo.com/bh3-wiki/2021/09/18/77124895/ffe644bd93b8add1c3cb81b48b1bc5d1_4810799954977811378.png\" alt=\"\"></div> <span>理之律者</span></div></td> <td><div class=\"obc-tmpl-weapon__role-stars\"><span>推荐指数</span> <div><i class=\"obc-tmpl__rate-icon\"></i><i class=\"obc-tmpl__rate-icon\"></i><i class=\"obc-tmpl__rate-icon\"></i><i class=\"obc-tmpl__rate-icon\"></i><i class=\"obc-tmpl__rate-icon\"></i></div></div></td> <td colspan=\"3\" class=\"obc-tmpl__rich-text\"><p style=\"white-space: pre-wrap;\">毕业武器，增加全伤以及开大时回复能量</p></td></tr></tbody></table> <!----></div></div><div style=\"order: 1;\"> <div data-part=\"review\" data-tmpl=\"weapon\" class=\"obc-tmpl__part obc-tmpl-weapon obc-tmpl__part--review obc-tmpl__part--align-banner\"><h2>武器测评</h2> <div class=\"obc-tmpl-valkyrie__skill-container\"><div><img src=\"https://uploadstatic.mihoyo.com/bh3-wiki/2021/09/09/77124895/df8ef078ef98bee423cf0a59ca2de4d1_7789384957800693425.gif\" class=\"mobile-gif\"></div> <div class=\"obc-tmpl-valkyrie__skill-item\"><div class=\"obc-tmpl-valkyrie__skill-item-desc\"><div class=\"text\"><p style=\"white-space: pre-wrap;\">理之律者的毕业武器，高倍率低消耗同时还能给敌人施加解析状态以及给施放者增加全伤的武器主动，再加上武器被动的无条件加伤这使得这把武器极其契合理之律者，而别的角色则可当做一个下位替代使用。其中迷城骇兔在战场中偶有携带。</p></div> <div class=\"obc-tmpl-valkyrie__skill-item-desc-gif\" style=\"padding: 0px;\"><img src=\"https://uploadstatic.mihoyo.com/bh3-wiki/2021/09/09/77124895/df8ef078ef98bee423cf0a59ca2de4d1_7789384957800693425.gif\" alt=\"\"></div></div></div></div> <!----></div></div></div></div></div> <div data-v-f0365338=\"\" class=\"detail__body-endpart\"><hr data-v-f0365338=\"\"> <p data-v-f0365338=\"\" class=\"detail__copyright\"><img data-v-f0365338=\"\" src=\"data:image/png;base64,\">\n        词条内容由圣芙蕾雅档案馆编辑团队原创，禁止转载\n      </p></div> <!---->",
