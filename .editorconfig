# EditorConfig - 统一编辑器编码风格
# https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{py}]
indent_size = 4
max_line_length = 120

[*.{ts,tsx,js,jsx,mjs,cjs,vue}]
indent_size = 2
max_line_length = 100

[*.{json,yaml,yml,toml}]
indent_size = 2

[*.{css,scss,less,html}]
indent_size = 2

[*.{md,markdown}]
trim_trailing_whitespace = false
max_line_length = off

[Makefile]
indent_style = tab

[*.{sh,bash,zsh}]
indent_style = space
indent_size = 2

[{.eslintrc,.prettierrc}]
indent_size = 2
